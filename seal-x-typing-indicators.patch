+    // ── Typing indicators ──────────────────────────────────────────
+    // Sending: while the box has text we tell the server "still typing" at
+    // most every TYPING_SEND_EVERY_MS, and send a "stopped" when it's emptied,
+    // sent, or the room changes. Receiving: each person shows as typing for
+    // TYPING_EXPIRE_MS after their last ping, so a missed "stopped" can't leave
+    // a stuck indicator.
+    const TYPING_SEND_EVERY_MS = 3000;
+    const TYPING_EXPIRE_MS = 5000;
+    const typingUsers = new Map();   // lowercase username -> { name, timer }
+    let typingSentAt = 0;
+    let typingSentRoom = null;
+
+    function myUsername() {
+      return ((CURRENT_USER && (CURRENT_USER.username || CURRENT_USER.user)) || '').toLowerCase();
+    }
+
+    function renderTypingLine() {
+      const line = $('typing-line');
+      const names = Array.from(typingUsers.values()).map(t => t.name);
+      const text = $('typing-text');
+      text.textContent = '';
+      if (!names.length) { line.classList.add('idle'); return; }
+      const bold = n => { const b = document.createElement('strong'); b.textContent = n; return b; };
+      const plain = t => document.createTextNode(t);
+      if (names.length === 1) {
+        text.append(bold(names[0]), plain(' is typing\u2026'));
+      } else if (names.length === 2) {
+        text.append(bold(names[0]), plain(' and '), bold(names[1]), plain(' are typing\u2026'));
+      } else if (names.length === 3) {
+        text.append(bold(names[0]), plain(', '), bold(names[1]), plain(' and '), bold(names[2]), plain(' are typing\u2026'));
+      } else {
+        text.append(plain('Several people are typing\u2026'));
+      }
+      line.classList.remove('idle');
+    }
+
+    function setTypingUser(username, typing) {
+      if (!username) return;
+      const key = username.toLowerCase();
+      if (key === myUsername()) return;
+      const existing = typingUsers.get(key);
+      if (existing) clearTimeout(existing.timer);
+      if (!typing) { typingUsers.delete(key); renderTypingLine(); return; }
+      const timer = setTimeout(() => { typingUsers.delete(key); renderTypingLine(); }, TYPING_EXPIRE_MS);
+      typingUsers.set(key, { name: username, timer });
+      renderTypingLine();
+    }
+
+    function clearTypingUsers() {
+      typingUsers.forEach(t => clearTimeout(t.timer));
+      typingUsers.clear();
+      renderTypingLine();
+    }
+
+    function stopMyTyping() {
+      if (typingSentRoom) API.chatTyping(typingSentRoom, false).catch(() => {});
+      typingSentRoom = null;
+      typingSentAt = 0;
+    }
+
+    $('chat-input').addEventListener('input', () => {
+      if (!myUsername()) return;
+      if (!$('chat-input').value.trim()) { stopMyTyping(); return; }
+      const now = Date.now();
+      if (typingSentRoom === CHAT_ROOM && now - typingSentAt < TYPING_SEND_EVERY_MS) return;
+      typingSentAt = now;
+      typingSentRoom = CHAT_ROOM;
+      API.chatTyping(CHAT_ROOM, true).catch(() => {});
+    });
+    // submitting clears the box without firing "input"; the server also
+    // clears us when the message goes out, but reset our own throttle too
