+    $('chat-input').addEventListener('blur', () => { if (!$('chat-input').value.trim()) stopMyTyping(); });
+    window.addEventListener('pagehide', () => {
+      if (typingSentRoom) { try { navigator.sendBeacon('/api/chat/typing', new Blob([JSON.stringify({ room: typingSentRoom, typing: false })], { type: 'application/json' })); } catch {} }
+    });
