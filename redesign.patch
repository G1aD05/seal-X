+.home-section { max-width: 1100px; margin: 0 auto; padding: 24px 24px 96px; }
+.home-eyebrow { font-family: var(--font-mono); font-size: 12px; color: var(--text-3); letter-spacing: 0.04em; margin-bottom: 14px; }
+.home-heading { font-size: clamp(28px, 4.2vw, 44px); font-weight: 600; letter-spacing: -0.04em; line-height: 1.1; margin-bottom: 36px; max-width: 640px; }
+.feature-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 14px; }
+.feature-card {
+  display: flex; flex-direction: column; gap: 10px;
+  padding: 28px; min-height: 210px;
+  background: var(--surface); border: 1px solid var(--border); border-radius: 22px;
+  transition: border-color 0.15s, background 0.15s, transform 0.15s;
+}
+.feature-card:hover { border-color: var(--border-2); background: var(--bg-3); transform: translateY(-2px); }
+.feature-icon { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 12px; background: rgba(255,255,255,0.05); border: 1px solid var(--border); color: var(--text); margin-bottom: 10px; }
+.feature-card h3 { font-size: 20px; font-weight: 600; letter-spacing: -0.03em; }
+.feature-card p { font-size: 14.5px; line-height: 1.55; color: var(--text-2); }
+.feature-link { margin-top: auto; display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 500; color: var(--text); }
+.feature-card:hover .feature-link .icon { transform: translateX(3px); }
+.feature-link .icon { transition: transform 0.15s; }
+
+.site-footer { border-top: 1px solid var(--border); padding: 48px 24px calc(48px + var(--dock-h)); }
+.footer-inner { max-width: 1100px; margin: 0 auto; display: flex; gap: 48px; justify-content: space-between; flex-wrap: wrap; }
+.footer-brand { display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 17px; letter-spacing: -0.02em; margin-bottom: 10px; }
+.footer-blurb { font-size: 13.5px; color: var(--text-3); max-width: 280px; line-height: 1.55; }
+.footer-cols { display: flex; gap: 56px; flex-wrap: wrap; }
+.footer-col h4 { font-size: 13px; font-weight: 600; margin-bottom: 14px; color: var(--text); }
+.footer-col a { display: block; font-size: 13.5px; color: var(--text-2); margin-bottom: 10px; transition: color 0.15s; }
+.footer-col a:hover { color: var(--text); }
+.footer-copy { max-width: 1100px; margin: 40px auto 0; font-size: 12.5px; color: var(--text-3); }
+
+/* very large Seals balances shouldn't push the nav and the user chip into each other */
+.wallet-chip { max-width: 210px; }
+#wallet-amount { display: inline-block; max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: bottom; }
