local function jag(p339: number, p340: number, p341: number, p342: number, p343: number, p344: number)
	
	local v345 = p341 - p339
	local v346 = p342 - p340
	local v347 = max(1, (sqrt(v345 * v345 + v346 * v346)))
	local v348 = -v346 / v347
	local v349 = v345 / v347
	local t17 = {{ p339, p340 }}
	for v350 = 1, p343 - 1 do
		local v351 = v350 / p343
		local v352 = (random() - 0.5) * 2 * p344 * sin(v351 * 3.141592653589793)
		local t18 = { p339 + v345 * v351 + v348 * v352, p340 + v346 * v351 + v349 * v352 }
		table.insert(t17, t18)
	end
	table.insert(t17, { p341, p342 })
	return t17
end
t.jag = jag
local function drawPts(p353: buffer, p354, p355: number, p356: number, p357: number, p358: number)
	
	for v359 = 1, #p354 - 1 do
		local v360 = p354[v359]
		local v361 = p354[v359 + 1]
		local v362 = v361[1] - v360[1]
		local v363 = v361[2] - v360[2]
		local v364 = max(1, (floor(max(abs(v362), (abs(v363))) + 0.5)))
		for v365 = 0, v364 do
			local v366 = v360[1] + v362 * v365 / v364
			local v367 = v360[2] + v363 * v365 / v364
			if p358 > 1 then
				blend(p353, v366 + 1, v367, p356, p357 * 0.8)
				blend(p353, v366 - 1, v367, p356, p357 * 0.8)
				blend(p353, v366, v367 + 1, p356, p357 * 0.8)
				blend(p353, v366, v367 - 1, p356, p357 * 0.8)
			end
			blend(p353, v366, v367, p355, p357)
		end
	end
end
t.drawPts = drawPts
local t19 = {}
local v_u_368 = Config
function t.bolts(p369, p370: number, p371: number, p372: number, p373: number, p374: number, p375: number, p376: number, p377: number, p378: number)
	
	if t19[0] then
		return
