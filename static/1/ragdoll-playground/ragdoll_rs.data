return t3--!nonstrict
--[[
	TTOServer  -  replacement server for the recovered "Ragdoll Playground" client.

	Put this in ServerScriptService as a regular Script.
	The original server code could not be recovered from the client, so this one was
	rebuilt from the messages the client sends and expects. It covers:

	  TTOShop    (RemoteEvent)    hello / state, kills counter, tolerant no-ops for the
	                              ad, gift, code, daily and funnel messages.
	  TTOBoards  (RemoteFunction) leaderboards: spent / playtime / kills / donations.
	  TTODesign  (RemoteFunction) saved UI preferences ("prefs" / "saveprefs").
	  TTONet     (RemoteEvent)    hello, ping, the "who" player list, and spectating
	                              (watch / unwatch / snap) relayed between players.

	Co-op rooms (invite / accept / ask / admit / kick, host to guest sync) are relayed here too; guests
	reach this script over the network when the game is started with --host.

	FREE_MODE (top of the script): when true, every Robux purchase is granted for free
	(trial, random power, crates, daily-all, tips) and all packs are unlocked. Set it to
	false for normal purchases. The client reads the same switch, so that is the only
	change needed.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

-- Set to false to put purchases back to normal (Robux prompts, original developer products).
local FREE_MODE = true

local STORE_NAME = "TTOData_v1"
local BOARD_KEYS = { "spent", "playtime", "kills", "donations" }
local MAX_ROWS = 50
local PREFS_MAX = 20000

------------------------------------------------------------------ remotes

local function getRemote(name: string, className: string)
	local r = ReplicatedStorage:FindFirstChild(name)
	if r and not r:IsA(className) then
		r:Destroy()
		r = nil
	end
	if not r then
		r = Instance.new(className)
		r.Name = name
		r.Parent = ReplicatedStorage
	end
	return r
end

ReplicatedStorage:SetAttribute("TTOFreeMode", FREE_MODE or nil)

local Net = getRemote("TTONet", "RemoteEvent")
local Shop = getRemote("TTOShop", "RemoteEvent")
local Boards = getRemote("TTOBoards", "RemoteFunction")
local Design = getRemote("TTODesign", "RemoteFunction")

------------------------------------------------------------------ data

local store
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	end
end
local boardStores = {}
for _, key in BOARD_KEYS do
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore("TTOBoard_" .. key)
	end)
	if ok then
		boardStores[key] = result
	end
end

local sessions = {} -- [Player] = { data = {...}, joined = os.clock(), dirty = false }

local function defaultData()
	return { kills = 0, playtime = 0, spent = 0, donations = 0, prefs = "", tipped = 0, tips = 0 }
end

local function load(player: Player)
	local data = defaultData()
	if store then
		for attempt = 1, 3 do
			local ok, saved = pcall(function()
				return store:GetAsync("u" .. player.UserId)
			end)
			if ok then
				if type(saved) == "table" then
					for k, v in saved do
						if data[k] ~= nil and type(v) == type(data[k]) then
							data[k] = v
						end
					end
				end
				break
			end
			task.wait(2 * attempt)
		end
	end
	return data
end

local function save(player: Player)
	local s = sessions[player]
	if not s or not store then
		return
	end
	s.data.playtime += math.floor(os.clock() - s.joined)
	s.joined = os.clock()
	pcall(function()
		store:SetAsync("u" .. player.UserId, s.data)
	end)
	for _, key in BOARD_KEYS do
		local ods = boardStores[key]
		local v = s.data[key]
		if ods and type(v) == "number" and v > 0 then
			pcall(function()
				ods:SetAsync(tostring(player.UserId), math.floor(v))
			end)
		end
	end
	s.dirty = false
end

------------------------------------------------------------------ shop

local ALL_PACKS = FREE_MODE and { tools = true, powers = true, everything = true, bundle = true, vip = true, builder = true, painter = true } or {}

local function shopState(player: Player)
	local s = sessions[player]
	local trialLeft = s and s.trialEnds and math.max(0, s.trialEnds - os.time()) or 0
	return {
		ready = true,
		now = os.time(),
		spins = 0,
		trialLeft = trialLeft,
		tipped = s and s.data.tipped or 0,
		tips = s and s.data.tips or 0,
		pending = {},
		passes = ALL_PACKS,
		free = { items = {}, skins = {} },
	}
end

local function sendState(player: Player)
	Shop:FireClient(player, "state", shopState(player))
	Shop:FireClient(player, "passes", ALL_PACKS)
end

------------------------------------------------------------------ free mode (no Robux)

local CrateData
do
	local ok, mod = pcall(function()
		return require(game:GetService("StarterPlayer").StarterPlayerScripts.TTOClient.CrateData)
	end)
	if ok then
		CrateData = mod
	else
		warn("[TTOServer] could not load CrateData, crates will be empty: " .. tostring(mod))
	end
end

local rng = Random.new()
local TRIAL_SECONDS = 1800
local CRATE_COUNTS = { crate_open = 1, crate_open3 = 3, crate_open9 = 9 }

local function grant(player: Player, key: string, extra)
	local payload = { k = key, id = HttpService:GenerateGUID(false), state = shopState(player) }
	if extra then
		for k, v in extra do
			payload[k] = v
		end
	end
	Shop:FireClient(player, "grant", payload)
end

-- Handles a "purchase" without charging. Returns true if the key was recognised.
local function freeBuy(player: Player, key: string)
	local s = sessions[player]
	if not s then
		return false
	end
	if key == "trial" then
		s.trialEnds = os.time() + TRIAL_SECONDS
		grant(player, key)
	elseif key == "randompower" or key == "dailyall" then
		grant(player, key)
	elseif CRATE_COUNTS[key] then
		local items = {}
		if CrateData then
			for _ = 1, CRATE_COUNTS[key] do
				local id = CrateData.pick("crate", function()
					return rng:NextNumber()
				end, true)
				if id then
					table.insert(items, id)
				end
			end
		end
		grant(player, key, { crate = items })
	else
		local amount = string.match(key, "^tip(%d+)$")
		if amount then
			-- Tips are a thank-you for the developer. In free mode they only count on the
			-- tip meter, nothing is charged or added to the leaderboards.
			s.data.tips += 1
			s.data.tipped += tonumber(amount)
			s.dirty = true
			grant(player, key)
		else
			return false -- gifts and ads use their own messages
		end
	end
	return true
end

Shop.OnServerEvent:Connect(function(player: Player, kind: any, data: any)
	if type(kind) ~= "string" then
		return
	end
	local s = sessions[player]
	if kind == "hello" then
		sendState(player)
	elseif kind == "kills" then
		local n = tonumber(data)
		if s and n then
			n = math.clamp(math.floor(n), 0, 30)
			s.data.kills += n
			s.dirty = true
		end
	elseif kind == "freebuy" then
		if FREE_MODE and type(data) == "string" then
			freeBuy(player, data)
		end
	elseif kind == "code" then
		Shop:FireClient(player, "coderesult", { ok = false, why = "invalid" })
	elseif kind == "giftlist" then
		Shop:FireClient(player, "giftlist", {})
	end
	-- played, tryfail, simulate, funnel, evseen, adpick, ad, daily, giftpick, groupclaim:
	-- nothing to do without the original monetisation backend.
end)

------------------------------------------------------------------ leaderboards

local boardCache, boardCacheAt = nil, 0

local function buildBoards(player: Player)
	if not boardCache or os.clock() - boardCacheAt > 30 then
		local cache = {}
		for _, key in BOARD_KEYS do
			local rows = {}
			local ods = boardStores[key]
			if ods then
				local ok, pages = pcall(function()
					return ods:GetSortedAsync(false, MAX_ROWS)
				end)
				if ok then
					local ok2, page = pcall(function()
						return pages:GetCurrentPage()
					end)
					if ok2 then
						for _, entry in page do
							local id = tonumber(entry.key)
							local name = "PLAYER"
							if id then
								local ok3, n = pcall(Players.GetNameFromUserIdAsync, Players, id)
								if ok3 then
									name = n
								end
							end
							table.insert(rows, { name = name, value = entry.value, id = id })
						end
					end
				end
			end
			cache[key] = rows
		end
		boardCache, boardCacheAt = cache, os.clock()
	end

	local out = {}
	local s = sessions[player]
	for _, key in BOARD_KEYS do
		local rows = boardCache[key]
		local mine = s and s.data[key] or 0
		local rank
		for i, row in rows do
			if row.id == player.UserId then
				rank = i
				break
			end
		end
		out[key] = { rows = rows, me = { value = mine, rank = rank } }
	end
	return out
end

Boards.OnServerInvoke = function(player: Player)
	local ok, result = pcall(buildBoards, player)
	if ok then
		return result
	end
	return nil
end

------------------------------------------------------------------ preferences

Design.OnServerInvoke = function(player: Player, op: any, value: any)
	local s = sessions[player]
	if not s then
		return nil
	end
	if op == "prefs" then
		return s.data.prefs
	elseif op == "saveprefs" then
		if type(value) ~= "string" or #value > PREFS_MAX then
			return false
		end
		s.data.prefs = value
		s.dirty = true
		return true
	end
	return nil
end

------------------------------------------------------------------ net: player list, spectating, co-op rooms
--
-- Every client keeps its own copy of the world and the room's host records what happens; this script
-- is only the relay between them (the same job the original server did):
--   host  -> everybody watching it:   s (ticks), c (corrections)
--   host  -> one watcher:             snap, ps, rs, cs   (answers to what that watcher asked for)
--   watcher -> its host:              pq, rq, cq (questions), g (a guest's own moves)
-- Players in a room are "guests" of the host (seats 1..3, the host is seat 0) and also watch the host.

local MAX_GUESTS = 3
local watching = {} -- [watcher] = target Player (spectators and room guests alike)
local info = {} -- [Player] = { allow, join, room, ping }
local hostOf = {} -- [guest] = host Player
local seatOf = {} -- [guest] = 1..3
local recording = {} -- [Player] = true while somebody watches it
local invited = {} -- invited[target][host] = os.clock()
local asked = {} -- asked[host][guest] = os.clock()
local INVITE_LIFE = 60

local function infoOf(p: Player)
	local i = info[p]
	if not i then
		i = { allow = "all", join = "ask", room = true }
		info[p] = i
	end
	return i
end

local function nameOf(p: Player)
	return p.DisplayName ~= "" and p.DisplayName or p.Name
end

local function tell(p: Player?, ...)
	if p and p.Parent then
		Net:FireClient(p, ...)
	end
end

local function playerOf(id: any)
	id = tonumber(id)
	return id and Players:GetPlayerByUserId(id) or nil
end

local function watchersOf(target: Player)
	local list = {}
	for w, t in watching do
		if t == target and w.Parent then
			table.insert(list, w)
		end
	end
	return list
end

local function guestsOf(host: Player)
	local list = {}
	for g, h in hostOf do
		if h == host and g.Parent then
			table.insert(list, g)
		end
	end
	table.sort(list, function(x, y)
		return seatOf[x] < seatOf[y]
	end)
	return list
end

------------------------------------------------------------------ cursor chat
-- "cc": the little chat box that follows a player's cursor. Only people who share a room (the host and its
-- guests) see each other's boxes. The server just relays: mode "o" = still typing (text so far), "f" = sent,
-- "x" = closed. Seat 0 is the host, guests are 1..3 (the same numbers the cursors use on every screen).

local CHAT_MAX = 48 -- the client cuts at the same length
local CHAT_TYPING_GAP = 0.05 -- at most 20 typing updates a second per player
local CHAT_SEND_GAP = 0.3 -- at most ~3 sent messages a second per player
local lastTyping = {} -- [Player] = os.clock()
local lastSent = {} -- [Player] = os.clock()

local function cleanChat(s: any)
	s = string.gsub(tostring(s or ""), "[^\32-\126]", "")
	return string.sub(s, 1, CHAT_MAX)
end

-- the room a player is in: its host and its own seat, or nil when it is not sharing a room with anybody
local function roomOf(p: Player)
	local host = hostOf[p]
	if host then
		return host, seatOf[p]
	end
	if #guestsOf(p) > 0 then
		return p, 0
	end
	return nil, nil
end

local function relayChat(p: Player, mode: string, text: string)
	local host, seat = roomOf(p)
	if not host then
		return
	end
	local payload = { s = seat, m = mode, t = text }
	if host ~= p then
		tell(host, "cc", p.UserId, payload)
	end
	for _, g in guestsOf(host) do
		if g ~= p then
			tell(g, "cc", p.UserId, payload)
		end
	end
end

local function playerList()
	local list = {}
	for _, p in Players:GetPlayers() do
		local i = infoOf(p)
		local host = hostOf[p]
		local target = watching[p]
		table.insert(list, {
			id = p.UserId,
			name = nameOf(p),
			allow = i.allow,
			join = i.join,
			room = i.room,
			ping = i.ping,
			host = host and host.UserId or nil,
			seat = seatOf[p],
			guests = #guestsOf(p),
			watching = (not host and target) and target.UserId or nil,
		})
	end
	return list
end

local function broadcastWho()
	local list = playerList()
	for _, p in Players:GetPlayers() do
		tell(p, "who", list)
	end
end

-- a host only records its world while somebody is watching it
local function syncRecording(target: Player)
	local on = #watchersOf(target) > 0
	if (recording[target] or false) ~= on then
		recording[target] = on or nil
		tell(target, "rec", on)
	end
end

local function stopWatching(w: Player)
	local target = watching[w]
	watching[w] = nil
	if target then
		syncRecording(target)
	end
end

local function leaveRoom(guest: Player, reason: string)
	local host = hostOf[guest]
	if not host then
		return
	end
	local seat = seatOf[guest]
	relayChat(guest, "x", "")
	hostOf[guest] = nil
	seatOf[guest] = nil
	stopWatching(guest)
	tell(host, "left", guest.UserId, seat, reason)
	tell(guest, "coopEnd", host.UserId, reason)
end

local function closeRoom(host: Player, reason: string)
	for _, g in guestsOf(host) do
		hostOf[g] = nil
		seatOf[g] = nil
		watching[g] = nil
		tell(g, "coopEnd", host.UserId, reason)
	end
	for _, w in watchersOf(host) do
		watching[w] = nil
		tell(w, "end", host.UserId)
	end
	if recording[host] then
		recording[host] = nil
		tell(host, "rec", false)
	end
end

local function freeSeat(host: Player)
	local used = {}
	for _, g in guestsOf(host) do
		used[seatOf[g]] = true
	end
	for seat = 1, MAX_GUESTS do
		if not used[seat] then
			return seat
		end
	end
	return nil
end

local function join(guest: Player, host: Player)
	if guest == host or hostOf[guest] == host then
		return
	end
	-- somebody who is in a room already has to leave it first, and a host who walks into another room closes theirs
	leaveRoom(guest, "moved")
	if #guestsOf(guest) > 0 then
		closeRoom(guest, "host left")
	end
	host = hostOf[host] or host
	if infoOf(host).room == false then
		tell(guest, "refused", host.UserId, 6)
		return
	end
	local seat = freeSeat(host)
	if not seat then
		tell(guest, "note", "THAT ROOM IS FULL")
		tell(host, "note", "YOUR ROOM IS FULL")
		return
	end
	stopWatching(guest)
	hostOf[guest] = host
	seatOf[guest] = seat
	watching[guest] = host
	tell(host, "join", guest.UserId, seat, nameOf(guest))
	tell(guest, "joined", host.UserId, seat)
	syncRecording(host)
	-- the host sends the newcomer a snapshot of its world
	tell(host, "need", guest.UserId)
	broadcastWho()
end

local function fresh(book, a: Player, b: Player)
	local t = book[a] and book[a][b]
	if t and os.clock() - t < INVITE_LIFE then
		book[a][b] = nil
		return true
	end
	return false
end

local function remember(book, a: Player, b: Player)
	book[a] = book[a] or {}
	book[a][b] = os.clock()
end

Net.OnServerEvent:Connect(function(player: Player, kind: any, a: any, b: any)
	if type(kind) ~= "string" then
		return
	end
	if kind == "hello" then
		tell(player, "who", playerList())
	elseif kind == "ping" then
		infoOf(player).ping = tonumber(a)
	elseif kind == "roomset" then
		infoOf(player).room = a == true
		broadcastWho()
	elseif kind == "allow" then
		infoOf(player).allow = type(a) == "string" and a or "all"
		broadcastWho()
	elseif kind == "joinset" then
		infoOf(player).join = a == "none" and "none" or "ask"
		broadcastWho()
	elseif kind == "watch" then
		local target = playerOf(a)
		if target and target ~= player then
			if infoOf(target).allow == "none" then
				tell(player, "denied", target.UserId)
				return
			end
			if hostOf[player] then
				leaveRoom(player, "moved")
			end
			stopWatching(player)
			watching[player] = target
			syncRecording(target)
			tell(target, "need", player.UserId)
			broadcastWho()
		end
	elseif kind == "unwatch" then
		stopWatching(player)
		broadcastWho()
	elseif kind == "snap" then
		-- a = the watcher it is for (echoed back from "need"), b = snapshot
		local w = playerOf(a)
		if w and type(b) == "table" and watching[w] == player then
			tell(w, "snap", player.UserId, b)
		end
	elseif kind == "s" or kind == "c" then
		-- the host's ticks and corrections go to everybody watching it
		if type(a) == "table" then
			for _, w in watchersOf(player) do
				tell(w, kind, player.UserId, a)
			end
		end
	elseif kind == "rs" or kind == "ps" or kind == "cs" then
		-- the host's answer to one watcher: a = who asked, b = the answer
		local w = playerOf(a)
		if w and type(b) == "table" and watching[w] == player then
			tell(w, kind, player.UserId, b)
		end
	elseif kind == "pq" or kind == "rq" or kind == "cq" or kind == "g" then
		-- a watcher (or a guest) talking to the host it is watching
		local host = watching[player]
		if host and type(a) == "table" then
			tell(host, kind, player.UserId, a)
		end
	elseif kind == "invite" then
		local target = playerOf(a)
		if not target or target == player then
			return
		end
		if hostOf[player] then
			tell(player, "note", "ONLY THE HOST CAN INVITE")
			return
		end
		if infoOf(target).allow == "none" then
			tell(player, "declined", target.UserId, 6)
			return
		end
		remember(invited, target, player)
		tell(target, "invite", player.UserId)
	elseif kind == "accept" then
		local host = playerOf(a)
		if host and fresh(invited, player, host) then
			join(player, host)
		end
	elseif kind == "decline" then
		local host = playerOf(a)
		if host then
			if invited[player] then
				invited[player][host] = nil
			end
			tell(host, "declined", player.UserId, 6)
		end
	elseif kind == "ask" then
		local host = playerOf(a)
		if not host or host == player then
			return
		end
		host = hostOf[host] or host
		local i = infoOf(host)
		if i.join == "none" or i.room == false then
			tell(player, "refused", host.UserId, 6)
			return
		end
		remember(asked, host, player)
		tell(host, "ask", player.UserId)
	elseif kind == "admit" then
		local guest = playerOf(a)
		if guest and fresh(asked, player, guest) then
			join(guest, player)
		end
	elseif kind == "refuse" then
		local guest = playerOf(a)
		if guest then
			if asked[player] then
				asked[player][guest] = nil
			end
			tell(guest, "refused", player.UserId, 6)
		end
	elseif kind == "kick" then
		local guest = playerOf(a)
		if guest and hostOf[guest] == player then
			leaveRoom(guest, "kicked")
			broadcastWho()
		end
	elseif kind == "leave" then
		leaveRoom(player, "left")
		broadcastWho()
	elseif kind == "cc" then
		-- cursor chat: a = mode ("o" typing, "f" sent, "x" closed), b = the text
		if a ~= "o" and a ~= "f" and a ~= "x" then
			return
		end
		local mode = a
		local text = mode == "x" and "" or cleanChat(b)
		local now = os.clock()
		if mode == "o" then
			if now - (lastTyping[player] or 0) < CHAT_TYPING_GAP then
				return
			end
			lastTyping[player] = now
		elseif mode == "f" then
			if text == "" then
				mode = "x"
			elseif now - (lastSent[player] or 0) < CHAT_SEND_GAP then
				return
			else
				lastSent[player] = now
			end
		end
		relayChat(player, mode, text)
	end
end)

-- pings change all the time, so refresh the list now and then
task.spawn(function()
	while true do
		task.wait(4)
		if #Players:GetPlayers() > 1 then
			broadcastWho()
		end
	end
end)

------------------------------------------------------------------ lifecycle

Players.PlayerAdded:Connect(function(player)
	if player:GetAttribute("Remote") then
		-- a guest from another computer: their data lives on their own machine
		broadcastWho()
		return
	end
	local data = load(player)
	if not player.Parent then
		return
	end
	sessions[player] = { data = data, joined = os.clock(), dirty = false }
	broadcastWho()
end)

Players.PlayerRemoving:Connect(function(player)
	lastTyping[player] = nil
	lastSent[player] = nil
	leaveRoom(player, "left the game")
	closeRoom(player, "host left")
	stopWatching(player)
	for w, t in watching do
		if t == player then
			watching[w] = nil
		end
	end
	info[player] = nil
	invited[player] = nil
	asked[player] = nil
	save(player)
	sessions[player] = nil
	task.defer(broadcastWho)
end)

-- Handle players who joined before this script ran.
for _, player in Players:GetPlayers() do
	task.spawn(function()
		sessions[player] = { data = load(player), joined = os.clock(), dirty = false }
	end)
end

-- Autosave every 2 minutes.
task.spawn(function()
	while true do
		task.wait(120)
		for player, s in sessions do
			if s.dirty then
				task.spawn(save, player)
			end
		end
	end
end)

game:BindToClose(function()
	if RunService:IsStudio() then
		return
	end
	for player in sessions do
		task.spawn(save, player)
	end
	task.wait(3)
end)
