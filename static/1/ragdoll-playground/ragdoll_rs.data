local function look(p46)
	
	if type(p46) ~= "table" then
		return "tab_free", "FREE", "GIFT"
	end
	if p46.spins and p46.keep then
		return "bigchest", p46.spins .. " SPINS", "+ POWER", "+ SKIN"
	end
	if p46.spins then
		local v47 = "spin"
		local v48 = p46.spins .. " FREE"
		if p46.spins == 1 then
			return v47, v48, "SPIN"
		end
		return v47, v48, "SPINS"
	end
	if p46.keep and p46.skin then
		return "chest", "POWER", "+ SKIN"
	end
	if p46.keep then
		return "mystery", "RANDOM", "POWER", "FOREVER"
	end
	if p46.skin then
		return "daily_rainbow", "RANDOM", "RAINBOW", "SKIN"
	end
	if p46.power then
		return "mystery", "5 MIN", "POWER"
	end
	return "tab_free", "FREE", "GIFT"
end
