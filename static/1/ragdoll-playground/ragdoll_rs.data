return t-- SEEDS tool: sprinkle seeds that grow into flowering vines.
--
--   * A seed falls, lands on whatever is below (a wall, the floor, a body of water) and sprouts.
--   * The sprout sends out vines (a "tip" that adds one node every STEP pixels). Vines hug walls and floors,
--     wander, branch, and droop like rope where they have nothing to cling to.
--   * Water speeds everything up: every tip samples the cells around it for water and grows up to
--     (1 + WET_BOOST) times faster the closer it is, and it steers towards the water it finds.
--   * Vines grow flowers. A flower starts as a bud and blooms over a few seconds.
--   * Plants are flammable. Any node that sits in hot cells catches fire, and fire runs along the vine from node to
--     node (and heats the cells around it, so it can jump to a neighbouring vine or burn a ragdoll). Nodes that grew
--     close to water are damp and resist fire. Burnt nodes turn to charcoal, then ash, then are gone.
--
-- This is an EXTRA module (like Stands or Spells): Tools.lua calls handles / press / release / deleteAt / drawCursor,
-- and TTOClient.client.lua calls update every sim tick and drawWorld every frame.
local Config = require(script.Parent.Config)
local rgb = Config.rgb
local mix = Config.mix
local readu32 = buffer.readu32
local writeu32 = buffer.writeu32
local floor = math.floor
local ceil = math.ceil
local sin = math.sin
local cos = math.cos
local abs = math.abs
local max = math.max
local min = math.min
local random = math.random
local atan2 = math.atan2
local exp = math.exp
local PI = math.pi

local t = { NAME = "Seeds" }
t.IDS = { seeds = true }
t.LIST = {
	{
		id = "seeds",
		tab = "TOOL",
		sec = "OTHER",
		name = "SEEDS",
		desc = "Sprinkle seeds that grow into flowering vines. They creep along walls and floors and race ahead near water. Dry plants burn like tinder",
		hint = "CLICK OR HOLD: SPRINKLE SEEDS  |  WET SOIL GROWS FASTER  |  BKSP: PULL UP A PLANT  |  WHEEL FLOWER COLOUR",
		chip = "SPRINKLE SEEDS",
	},
}

-- wheel modes (Tools.SIZES.seeds in Tools.lua holds the same names)
t.MODES = { "MIXED", "SUNNY", "BERRY", "SKY" }

----------------------------------------------------------------- tuning
local STEP = 2 -- pixels between two vine nodes
local GROW_SPEED = 8 -- pixels per second for a tip far from water
local WET_BOOST = 3 -- a tip right next to water grows (1 + WET_BOOST) times as fast
local WET_REACH = 26 -- pixels: water further away than this does not help
local GRAV = 430 -- seed fall speed, same as the physics
local SPRINKLE_GAP = 0.13 -- seconds between seeds while the button is held
local SPROUT_TIME = 0.6 -- seconds a landed seed sits before it sprouts
local MAX_SEEDS = 48
local MAX_PLANTS = 24
local MAX_NODES_TOTAL = 2600
local MAX_NODES_PLANT = 260
local MAX_TIPS = 7
local MAX_FLOWERS = 46
local FIRE_EVERY = 3 -- ticks between fire scans
local DRY_IGNITE = 32 -- heat (0..255) a dry node catches fire at
local DAMP_IGNITE = 150 -- ... and a damp one (grew within reach of water)
local SPREAD_RATE = 5 -- per second, fire creeping from a burning node to a neighbouring one

local AIR, WATER = Config.AIR, Config.WATER
local BLOOD, ASH = Config.BLOOD, Config.ASH

local G, World, Fire, Particles, Sfx

local seeds = {} -- falling or sprouting seeds
local plants = {} -- grown plants
local held = false
local sprinkleT = 0
local tickN = 0
local clock = 0

----------------------------------------------------------------- helpers

local function snd(name: string, vol: number, pitch: number)
	if Sfx and Sfx.play then
		Sfx.play(name, vol, pitch)
	end
end

local function flash(text: string)
	local UI = G and G.UI
	if UI and UI.flashHint then
		UI.flashHint(text, Color3.fromRGB(150, 236, 172))
	end
end

local function matAt(x: number, y: number): number
	return World.matAt(floor(x), floor(y))
end

-- vines and seeds can pass through these
local function isFree(x: number, y: number): boolean
	local m = World.matAt(floor(x), floor(y))
	return m == AIR or m == BLOOD or m == ASH
end

local function angDiff(a: number, b: number): number
	local d = (b - a) % (2 * PI)
	if d > PI then
		d = d - 2 * PI
	end
	return d
end

local function modeNow(): number
	local Tools = G and G.Tools
	local sz = Tools and Tools.SIZES and Tools.SIZES.seeds
	local v = sz and sz.value or 1
	return (v >= 1 and v <= #t.MODES) and floor(v) or 1
end

local DX, DY = {}, {}
for d = 1, 8 do
	DX[d] = cos((d - 1) * PI / 4)
	DY[d] = sin((d - 1) * PI / 4)
end
local RINGS = { 3, 6, 10, 15, 22 }

-- How wet is it here? 0 = no water in reach, 1 = water right next to us. Also returns the direction (an angle)
-- of the closest water, so vines can lean towards it.
local function sniffWater(x: number, y: number): (number, number?)
	if matAt(x, y) == WATER then
		return 1, nil
	end
	local best, bestDir = 0, nil
	for _, r in RINGS do
		local w = 1 - (r - 2) / WET_REACH
		if w <= best then
			break
		end
		for d = 1, 8 do
			if matAt(x + DX[d] * r, y + DY[d] * r) == WATER then
				best = w
				bestDir = atan2(DY[d], DX[d])
				break
			end
		end
	end
	return best, bestDir
end

-- the way "out of the ground" at (x, y): away from the solid cells around it (straight up if there are none)
local function surfaceNormal(x: number, y: number): number
	local sx, sy, n = 0, 0, 0
	for d = 0, 15 do
		local a = d * PI / 8
		local ca, sa = cos(a), sin(a)
		for r = 2, 4, 2 do
			if not isFree(x + ca * r, y + sa * r) then
				sx = sx - ca
				sy = sy - sa
				n = n + 1
			end
		end
	end
	if n == 0 or (abs(sx) < 0.01 and abs(sy) < 0.01) then
		return -PI / 2
	end
	return atan2(sy, sx)
end

----------------------------------------------------------------- flowers

-- { petal, light petal, centre }
local PALETTES = {
	{ rgb(255, 214, 64), rgb(255, 245, 160), rgb(150, 84, 22) }, -- SUNNY
	{ rgb(244, 84, 160), rgb(255, 170, 214), rgb(255, 224, 96) }, -- BERRY
	{ rgb(98, 150, 255), rgb(206, 226, 255), rgb(255, 232, 120) }, -- SKY
}
local MODE_COL = { rgb(255, 214, 120), rgb(255, 214, 64), rgb(244, 84, 160), rgb(98, 150, 255) }

local function makeFlower(mode: number, big: boolean)
	local pal = PALETTES[mode > 1 and mode - 1 or random(1, #PALETTES)]
	return {
		pal = pal,
		r = (big and 3.4 or 2.3) + random() * 0.9,
		at = 0.8 + random() * 1.8, -- seconds after the node appeared that the bud starts to open
		rot = random() * PI,
		petals = random(5, 7),
	}
end

----------------------------------------------------------------- plants

local function newNode(P, par: number, x: number, y: number, ang: number): number
	local nodes = P.nodes
	local depth = par > 0 and nodes[par].depth + 1 or 0
	local n = {
		x = x,
		y = y,
		par = par,
		kids = {},
		ang = ang,
		depth = depth,
		born = P.age,
		w = depth <= 6 and 2 or 1,
		leaf = (depth % 6 == 0 and depth > 0) and 1 or ((depth % 6 == 3) and -1 or 0),
		fire = 0, -- seconds of burning left (0 = not burning)
		fireT = 0, -- how long it has been burning
		ash = 0, -- > 0: burnt out; counts up while it fades
		dead = false,
		moist = false,
		flower = nil,
	}
	local idx = #nodes + 1
	nodes[idx] = n
	if par > 0 then
		table.insert(nodes[par].kids, idx)
	end
	return idx
end

local function addTip(P, node: number, ang: number, life: number, side: number)
	local tip = {
		n = node,
		ang = ang,
		life = life,
		maxLife = life,
		acc = 0,
		wet = 0,
		wdir = nil,
		recheck = 0,
		side = side,
		air = 0,
		sinceB = 0,
		sinceF = 0,
		gap = random(6, 10),
		alive = true,
	}
	table.insert(P.tips, tip)
	return tip
end

local function totalNodes(): number
	local n = 0
	for _, P in plants do
		n = n + #P.nodes - P.dead
	end
	return n
end

local function removePlant(P)
	local i = table.find(plants, P)
	if i then
		table.remove(plants, i)
	end
end

local function germinate(s)
	while #plants >= MAX_PLANTS or (#plants > 0 and totalNodes() > MAX_NODES_TOTAL) do
		table.remove(plants, 1)
	end
	local P = {
		nodes = {},
		tips = {},
		mode = s.mode,
		age = 0,
		dead = 0,
		flowers = 0,
		flowerNodes = {},
	}
	local nrm = surfaceNormal(s.x, s.y)
	local wet = sniffWater(s.x, s.y)
	local root = newNode(P, 0, s.x, s.y, nrm)
	P.nodes[root].w = 2
	P.nodes[root].moist = wet > 0.45
	local boost = 1 + 0.8 * wet
	-- one tip straight out of the ground, two along the surface (tilted a little into it so they hug it)
	addTip(P, root, nrm + (random() - 0.5) * 0.5, floor((60 + random(0, 30)) * boost), 1)
	addTip(P, root, nrm + PI / 2 + 0.25, floor((50 + random(0, 30)) * boost), 1)
	addTip(P, root, nrm - PI / 2 - 0.25, floor((50 + random(0, 30)) * boost), -1)
	table.insert(plants, P)
	s.plant = P
	snd("grab", 0.25, 1.7)
	return P
end

-- a tip ran out of life or room: it ends in a bigger flower
local function endTip(P, tip)
	tip.alive = false
	local n = P.nodes[tip.n]
	if n and not n.flower and P.flowers < MAX_FLOWERS + 10 then
		n.flower = makeFlower(P.mode, true)
		P.flowers = P.flowers + 1
		table.insert(P.flowerNodes, tip.n)
	end
end

local function aliveTips(P): number
	local c = 0
	for _, tip in P.tips do
		if tip.alive then
			c = c + 1
		end
	end
	return c
end

-- one STEP of growth. Returns false when the tip is stuck.
local function advance(P, tip): boolean
	local nodes = P.nodes
	local cur = nodes[tip.n]
	if cur.dead or cur.fire > 0 or cur.ash > 0 then
		return false
	end
	if #nodes >= MAX_NODES_PLANT then
		return false
	end

	-- wander, and lean towards water when there is some near
	tip.ang = tip.ang + (random() - 0.5) * 0.45
	if tip.wdir and tip.wet > 0.1 then
		tip.ang = tip.ang + max(-0.14, min(0.14, angDiff(tip.ang, tip.wdir))) * tip.wet
	end

	-- clinging to something (solid within 3px on either side)? then climb a little; otherwise droop like rope
	local ca, sa = cos(tip.ang + PI / 2), sin(tip.ang + PI / 2)
	local clinging = not isFree(cur.x + ca * 3, cur.y + sa * 3) or not isFree(cur.x - ca * 3, cur.y - sa * 3)
	if clinging then
		tip.air = 0
		tip.ang = tip.ang + angDiff(tip.ang, -PI / 2) * 0.012
	else
		tip.air = tip.air + 1
		tip.ang = tip.ang + angDiff(tip.ang, PI / 2) * min(0.12, 0.02 * tip.air)
		tip.life = tip.life - 0.5 -- a vine in thin air runs out sooner
	end

	-- look ahead; go round whatever is in the way (preferred side first)
	local ahead = STEP + 1.5
	local a = tip.ang
	if not isFree(cur.x + cos(a) * ahead, cur.y + sin(a) * ahead) then
		local found = false
		for k = 1, 7 do
			for s = 1, 2 do
				local sg = (s == 1) and tip.side or -tip.side
				local a2 = tip.ang + sg * k * 0.32
				if isFree(cur.x + cos(a2) * ahead, cur.y + sin(a2) * ahead) then
					a = a2
					found = true
					break
				end
			end
			if found then
				break
			end
		end
		if not found then
			return false
		end
		tip.ang = a
	end

	local idx = newNode(P, tip.n, cur.x + cos(a) * STEP, cur.y + sin(a) * STEP, a)
	local n = nodes[idx]
	n.moist = tip.wet > 0.45
	tip.n = idx
	tip.life = tip.life - 1
	tip.sinceB = tip.sinceB + 1
	tip.sinceF = tip.sinceF + 1

	-- flowers along the vine, a bit more often where it is wet (not at the very start)
	if tip.sinceF >= tip.gap and P.flowers < MAX_FLOWERS and tip.life < tip.maxLife * 0.85 then
		n.flower = makeFlower(P.mode, false)
		P.flowers = P.flowers + 1
		table.insert(P.flowerNodes, idx)
		tip.sinceF = 0
		tip.gap = max(4, random(6, 11) - floor(tip.wet * 3))
	end

	-- branch off
	if tip.sinceB >= 12 + random(0, 10) and #nodes < MAX_NODES_PLANT * 0.8 then
		tip.sinceB = 0
		if aliveTips(P) < MAX_TIPS and random() < 0.35 + 0.4 * tip.wet then
			local sg = random() < 0.5 and -1 or 1
			addTip(P, idx, tip.ang + sg * (0.6 + random() * 0.6), floor(tip.life * 0.6) + 8, sg)
		end
	end
	return true
end

local function growTip(P, tip, dt: number)
	local nodes = P.nodes
	local cur = nodes[tip.n]
	tip.recheck = tip.recheck - dt
	if tip.recheck <= 0 then
		tip.wet, tip.wdir = sniffWater(cur.x, cur.y)
		tip.recheck = 0.2 + random() * 0.15
	end
	tip.acc = tip.acc + GROW_SPEED * (1 + WET_BOOST * tip.wet) * dt
	while tip.acc >= STEP and tip.alive do
		tip.acc = tip.acc - STEP
		if tip.life <= 0 or not advance(P, tip) then
			endTip(P, tip)
		end
	end
end

----------------------------------------------------------------- fire

local function ignite(n)
	if n.fire > 0 or n.ash > 0 or n.dead then
		return
	end
	n.fire = n.moist and (0.5 + random() * 0.4) or (1.3 + random() * 1.4)
	n.fireT = 0
	n.flower = nil
end

local function burnNode(P, n, dt: number)
	n.fire = n.fire - dt
	n.fireT = n.fireT + dt
	local x, y = floor(n.x), floor(n.y)
	Fire.add(x, y - 1, 150 + random(0, 80))
	if random() < 0.35 then
		Fire.add(x + random(-1, 1), y - 3, 110)
	end
	if Particles then
		if random() < 0.06 and Particles.smoke then
			Particles.smoke(n.x, n.y - 3, 1, 3)
		end
		if random() < 0.04 and Particles.sparks then
			Particles.sparks(n.x, n.y - 2, 1, 22)
		end
	end
	if n.moist then
		n.fire = n.fire - dt * 2 -- damp vines hiss out quickly
	end
	if matAt(n.x, n.y) == WATER then
		n.fire = 0
	end

	-- the fire creeps along the vine
	if n.fireT >= 0.25 and n.fire > 0 then
		local chance = 1 - exp(-SPREAD_RATE * dt)
		local nodes = P.nodes
		if n.par > 0 then
			local o = nodes[n.par]
			if random() < chance * (o.moist and 0.25 or 1) then
				ignite(o)
			end
		end
		for _, k in n.kids do
			local o = nodes[k]
			if random() < chance * (o.moist and 0.25 or 1) then
				ignite(o)
			end
		end
	end

	if n.fire <= 0 then
		n.fire = 0
		n.ash = 0.001
	end
end

local function scanPlant(P, dt: number, hot: boolean)
	local nodes = P.nodes
	local anyLeft = false
	for i = 1, #nodes do
		local n = nodes[i]
		if not n.dead then
			anyLeft = true
			if n.ash > 0 then
				n.ash = n.ash + dt
				if n.ash > 5 then
					n.dead = true
					n.flower = nil
					P.dead = P.dead + 1
				end
			elseif n.fire > 0 then
				burnNode(P, n, dt)
			else
				local m = matAt(n.x, n.y)
				if not (m == AIR or m == WATER or m == BLOOD or m == ASH) then
					-- built over (cement, metal, ice ...) or dissolved: this bit of vine is gone
					n.dead = true
					n.flower = nil
					P.dead = P.dead + 1
				elseif hot then
					local h = max(Fire.heatAt(n.x, n.y), Fire.heatAt(n.x, n.y - 1))
					if h >= (n.moist and DAMP_IGNITE or DRY_IGNITE) then
						ignite(n)
					end
				end
			end
		end
	end
	if not anyLeft then
		removePlant(P)
	end
end

----------------------------------------------------------------- seeds

-- drop a seed at (x, y). Returns the seed, or nil if (x, y) is inside something solid.
local function dropSeed(x: number, y: number, vx: number?)
	if #seeds >= MAX_SEEDS then
		table.remove(seeds, 1)
	end
	local s = { x = x, y = y, vx = vx or 0, vy = 0, mode = modeNow(), state = "fall", t = 0, water = false }
	local m = matAt(x, y)
	if m == WATER then
		-- let go under water: it bobs up to the surface and floats there
		local yy, guard = y, 0
		while matAt(x, yy) == WATER and guard < 220 do
			yy = yy - 1
			guard = guard + 1
		end
		s.y = yy + 0.5
		s.state = "rest"
		s.water = true
	elseif not isFree(x, y) then
		return nil
	end
	table.insert(seeds, s)
	return s
end

local function updateSeed(s, dt: number): boolean -- false = remove
	if s.state == "fall" then
		s.vy = s.vy + GRAV * dt
		local nx, ny = s.x + s.vx * dt, s.y + s.vy * dt
		local steps = max(1, ceil(max(abs(nx - s.x), abs(ny - s.y))))
		local sx, sy = s.x, s.y
		for i = 1, steps do
			local px = sx + (nx - sx) * i / steps
			local py = sy + (ny - sy) * i / steps
			local m = matAt(px, py)
			if m == AIR or m == BLOOD or m == ASH then
				s.x, s.y = px, py
			else
				s.state = "rest"
				s.water = (m == WATER)
				break
			end
		end
		if s.y > Config.H + 4 or s.x < -4 or s.x > Config.W + 4 then
			return false
		end
	else
		s.t = s.t + dt
		if s.t >= SPROUT_TIME then
			germinate(s)
			return false
		end
	end
	return true
end

----------------------------------------------------------------- the EXTRA-module interface

function t.handles(id: string): boolean
	return t.IDS[id] == true
end

local function undoFor(s)
	return function()
		local i = table.find(seeds, s)
		if i then
			table.remove(seeds, i)
			return true
		end
		if s.plant and table.find(plants, s.plant) then
			removePlant(s.plant)
			return true
		end
		return false
	end
end

function t.press(id: string)
	if id ~= "seeds" then
		return
	end
	held = true
	sprinkleT = SPRINKLE_GAP
	local x, y = G.Tools.mouse()
	local s = dropSeed(x, y, (random() - 0.5) * 16)
	if not s then
		flash("CAN'T PLANT INSIDE A WALL")
		return
	end
	snd("click", 0.25, 1.9)
	local Arsenal = G.Arsenal
	if Arsenal and Arsenal.remember then
		Arsenal.remember(undoFor(s), "SEEDS")
	end
end

function t.release(_id: string)
	held = false
end

function t.update(dt: number)
	clock = clock + dt
	tickN = tickN + 1

	if held then
		if G.Tools.toolId() == "seeds" then
			sprinkleT = sprinkleT - dt
			if sprinkleT <= 0 then
				sprinkleT = SPRINKLE_GAP
				local x, y = G.Tools.mouse()
				if dropSeed(x + (random() - 0.5) * 6, y, (random() - 0.5) * 24) then
					snd("click", 0.15, 1.6 + random() * 0.6)
				end
			end
		else
			held = false
		end
	end

	for i = #seeds, 1, -1 do
		if not updateSeed(seeds[i], dt) then
			table.remove(seeds, i)
		end
	end

	for i = #plants, 1, -1 do
		local P = plants[i]
		P.age = P.age + dt
		for j = #P.tips, 1, -1 do
			local tip = P.tips[j]
			if not tip.alive then
				table.remove(P.tips, j)
			else
				local cur = P.nodes[tip.n]
				if cur.dead or cur.fire > 0 or cur.ash > 0 then
					tip.alive = false -- the end of this vine burnt: it stops growing
				else
					growTip(P, tip, dt)
				end
			end
		end
	end

	if tickN % FIRE_EVERY == 0 then
		local hot = Fire.active()
		local dtf = dt * FIRE_EVERY
		for i = #plants, 1, -1 do
			scanPlant(plants[i], dtf, hot)
		end
	end
end

-- Backspace / delete tool: pull up the plant that has a node within a few pixels of (x, y)
function t.deleteAt(x: number, y: number): boolean
	local hit = false
	for i = #plants, 1, -1 do
		local P = plants[i]
		for _, n in P.nodes do
			if not n.dead and (n.x - x) ^ 2 + (n.y - y) ^ 2 <= 49 then
				table.remove(plants, i)
				hit = true
				break
			end
		end
	end
	for i = #seeds, 1, -1 do
		local s = seeds[i]
		if (s.x - x) ^ 2 + (s.y - y) ^ 2 <= 49 then
			table.remove(seeds, i)
			hit = true
		end
	end
	if hit then
		snd("click", 0.4, 0.8)
	end
	return hit
end

function t.clear()
	table.clear(seeds)
	table.clear(plants)
	held = false
end

function t.debug(): string
	local nodes, burning = 0, 0
	for _, P in plants do
		for _, n in P.nodes do
			if not n.dead then
				nodes = nodes + 1
				if n.fire > 0 then
					burning = burning + 1
				end
			end
		end
	end
	return string.format("seeds=%d plants=%d nodes=%d burning=%d", #seeds, #plants, nodes, burning)
end

function t.count(): number
	return #plants
end

function t.init(game)
	G = game
	World = game.World
	Fire = game.Fire
	Particles = game.Particles
	Sfx = game.Sfx
end

----------------------------------------------------------------- drawing

local STEM = { rgb(74, 168, 82), rgb(60, 146, 70), rgb(96, 190, 96) }
local STEM_DK = rgb(38, 106, 52)
local LEAF = rgb(104, 204, 96)
local LEAF_DK = rgb(52, 138, 66)
local EMBER = { rgb(255, 196, 60), rgb(255, 120, 30), rgb(224, 70, 20) }
local CHAR = rgb(40, 34, 32)
local ASHC = rgb(120, 118, 122)
local SEED_BROWN = rgb(122, 78, 40)
local SEED_LIGHT = rgb(196, 146, 84)
local SPROUT = rgb(120, 220, 110)

local function plot(buf: buffer, x: number, y: number, col: number, alpha: number)
	local W, H = Config.W, Config.H
	x, y = floor(x), floor(y)
	if x >= 0 and y >= 0 and x < W and y < H then
		local off = (x + y * W) * 4
		writeu32(buf, off, alpha >= 1 and col or mix(readu32(buf, off), col, alpha))
	end
end

local function drawFlower(buf: buffer, n, age: number)
	local fl = n.flower
	local b = (age - fl.at) / 2.5
	if b <= 0 then
		return
	end
	b = min(b, 1)
	local fx, fy = n.x, n.y - 1
	local pal = fl.pal
	if b < 0.35 then
		plot(buf, fx, fy, pal[1], 1) -- bud
		plot(buf, fx, fy - 1, pal[2], 1)
		return
	end
	local R = fl.r * b
	local sway = sin(clock * 1.6 + fx * 0.2) * 0.12
	for i = 1, fl.petals do
		local a = fl.rot + sway + (i - 1) * 2 * PI / fl.petals
		local ca, sa = cos(a), sin(a)
		plot(buf, fx + ca * R, fy + sa * R * 0.85, pal[1], 1)
		plot(buf, fx + ca * R * 0.55, fy + sa * R * 0.5, pal[2], 1)
	end
	plot(buf, fx, fy, pal[3], 1)
	plot(buf, fx + 1, fy, pal[3], 1)
end

local function drawPlant(buf: buffer, P)
	local nodes = P.nodes
	local flick = floor(clock * 18)
	for i = 1, #nodes do
		local n = nodes[i]
		if not n.dead then
			local col, alpha = STEM[(i % 3) + 1], 1
			local burning = n.fire > 0
			if n.ash > 0 then
				col = mix(CHAR, ASHC, min(1, n.ash / 3))
				alpha = n.ash > 3.5 and max(0, 1 - (n.ash - 3.5) / 1.5) or 1
			elseif burning then
				col = EMBER[((i * 7 + flick) % 3) + 1]
			end
			if n.par > 0 then
				local pn = nodes[n.par]
				if not pn.dead then
					plot(buf, (pn.x + n.x) * 0.5, (pn.y + n.y) * 0.5, col, alpha)
				end
			end
			plot(buf, n.x, n.y, col, alpha)
			if n.w == 2 then
				-- thick stem near the root: a second, darker pixel to one side
				plot(buf, n.x - sin(n.ang), n.y + cos(n.ang), (n.ash > 0 or burning) and col or STEM_DK, alpha)
			end
			-- leaves
			if n.leaf ~= 0 and n.ash <= 0 and not burning then
				local age = P.age - n.born
				if age > 0.4 then
					local la = n.ang + n.leaf * 1.1
					local len = age > 1.2 and 3 or 2
					for r = 1, len do
						plot(buf, n.x + cos(la) * r, n.y + sin(la) * r, r == len and LEAF_DK or LEAF, 1)
					end
				end
			end
		end
	end
	-- flowers on top
	for _, idx in P.flowerNodes do
		local n = nodes[idx]
		if n and n.flower and not n.dead and n.fire <= 0 and n.ash <= 0 then
			drawFlower(buf, n, P.age - n.born)
		end
	end
end

function t.drawWorld(buf: buffer)
	for _, P in plants do
		drawPlant(buf, P)
	end
	for _, s in seeds do
		if s.state == "fall" then
			plot(buf, s.x, s.y, SEED_BROWN, 1)
			plot(buf, s.x, s.y - 1, SEED_LIGHT, 1)
		else
			local k = s.t / SPROUT_TIME
			plot(buf, s.x, s.y, SEED_BROWN, 1)
			plot(buf, s.x + 1, s.y, SEED_LIGHT, 1)
			if k > 0.4 then
				plot(buf, s.x, s.y - 1, SPROUT, 1)
				if k > 0.75 then
					plot(buf, s.x, s.y - 2, SPROUT, 1)
				end
			end
		end
	end
end

-- cursor: a dotted line down to where the seed would land (blue marker if there is water close by)
function t.drawCursor(buf: buffer, id: string)
	if id ~= "seeds" then
		return
	end
	local Tools = G.Tools
	local x, y = Tools.mouse()
	Tools.cursorWant = MODE_COL[modeNow()]
	local cx, cy = floor(x), floor(y)
	if not isFree(cx, cy) then
		return
	end
	local yy, steps = cy, 0
	while steps < 170 and isFree(cx, yy + 1) do
		yy = yy + 1
		steps = steps + 1
	end
	for k = 5, steps, 4 do
		plot(buf, cx, cy + k, SPROUT, 0.45)
	end
	local wet = sniffWater(cx, yy)
	local mark = wet > 0.3 and rgb(120, 200, 255) or SPROUT
	for i = -2, 2 do
		plot(buf, cx + i, yy + 1, mark, 0.8)
	end
	plot(buf, cx, yy, mark, 0.8)
	plot(buf, cx, yy - 1, mark, 0.8)
end

return t




