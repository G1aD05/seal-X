local function wrapHead(p23, p24: string, p25: number)
	
	local headingWidth = p23.headingWidth
	if not headingWidth then
		return p24, nil
	end
	local t6 = {}
	local v_u_26 = headingWidth
	local v_u_27 = p25
	local function fits(p28: string)
		
		if t6[0] then
			return
		end
		return v_u_26(p28) + 2 <= v_u_27
	end
	local t7 = {}
	local v_u_29 = headingWidth
	local v_u_30 = p25
	local function cut(p31: string)
		
		if t7[0] then
			return
		end
		while #p31 > 2 and not (v_u_29(p31 .. ".") + 2 <= v_u_30) do
			local v32 = #p31 - 1
			p31 = string.sub(p31, 1, v32)
		end
		return p31 .. "."
	end
	if headingWidth(p24) + 2 <= p25 then
		return p24, nil
	end
	local v33 = ""
	local v34 = ""
	for v35 in string.gmatch(p24, "%S+") do
		local v36 = v33 == "" and v35 and v35 or v33 .. " " .. v35
		if v34 == "" and headingWidth(v36) + 2 <= p25 then
			v33 = v36
		elseif v33 == "" then
			v33 = cut(v35)
		else
			v34 = v34 == "" and v35 and v35 or v34 .. " " .. v35
		end
	end
	if v34 ~= "" and not (headingWidth(v34) + 2 <= p25) then
		v34 = cut(v34)
	end
	return v33, v34 ~= "" and v34 and v34 or nil
end
function t.left()
	
	local daily2 = Products.daily
	if type(daily2) == "table" then
		local days2 = daily2.days
		if type(days2) ~= "table" or not (#daily2.days > 0) then
			daily2 = nil
		end
	else
		daily2 = nil
	end
	if not (daily2 and Products.state.ready) then
		return nil
	end
	local n2 = daily2.n
	local v37 = tonumber(n2) or 0
	if #daily2.days <= v37 and not daily2.loop then
		return nil
	end
	if v37 == 0 then
		return 0
	end
	local v38
	if daily2.all == true then
		local round2 = daily2.round
		if (tonumber(round2) or 0) == 0 then
			local n3 = daily2.n
			local v39 = tonumber(n3) or 0
			local v40 = #daily2.days
			local unlock4 = daily2.unlock
			v38 = v39 < min(v40, tonumber(unlock4) or #daily2.days)
		else
			v38 = false
		end
	else
		v38 = false
	end
	if v38 then
		return 0
	end
	local t8 = daily2.t
	local v41 = tonumber(t8) or 0
	local gap = daily2.gap
	return (max(0, v41 + (tonumber(gap) or 72000) - Products.now()))
end
function t.ready()
	
	return t.left() == 0
end
local function count(p42)
	
	local n4 = p42.n
	local v43 = tonumber(n4) or 0
	return #p42.days <= v43 and (p42.loop and t.left() == 0) and 0 or min(v43, #p42.days)
end
function t.day()
	
	local daily3 = Products.daily
	if type(daily3) == "table" then
		local days3 = daily3.days
		if type(days3) ~= "table" or not (#daily3.days > 0) then
			daily3 = nil
		end
	else
		daily3 = nil
	end
	if not daily3 then
		return 1
	end
	local n5 = daily3.n
	local v44 = tonumber(n5) or 0
	if #daily3.days <= v44 then
		return daily3.loop and 1 or #daily3.days
	end
	return v44 + 1
end
local v_u_45 = Players
