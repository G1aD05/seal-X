		local v38 = v_u_31(p35 + 0.5)
		if v37 >= 0 and (v37 < 16 and (v38 >= 0 and (v38 < 16 and (not v_u_33[v38 * 16 + v37 + 1] or p36 ~= t2.B)))) then
			v_u_33[v38 * 16 + v37 + 1] = p36
		end
