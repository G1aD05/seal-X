		if t22[0] then
			return
		end
		p386.pts = {}
		for _, v387 in v_u_383 do
			local v388: number = min(1, max(p386.t, 0) / 0.06)
			local v389 = v387.l * v388
			local v390 = v_u_384 + cos(v387.a) * v389
			local v391 = v_u_385 + sin(v387.a) * v389
			local pts = p386.pts
			local v392 = jag(v_u_384, v_u_385, v390, v391, 7, v389 * 0.22)
			table.insert(pts, v392)
			if random() < 0.6 then
				local v393 = 0.35 + random() * 0.35
				local v394 = v_u_384 + cos(v387.a) * v389 * v393
				local v395 = v_u_385 + sin(v387.a) * v389 * v393
				local v396 = v387.a + (random() - 0.5) * 1.6
				local pts2 = p386.pts
				local v397 = jag(v394, v395, v394 + cos(v396) * v389 * 0.4, v395 + sin(v396) * v389 * 0.4, 4, 3)
				table.insert(pts2, v397)
			end
		end
	end
	local t23 = {
		life = 0,
		pts = 0,
		reT = 0,
		d = 0,
		life = p374,
		pts = {}
	}
	local t24 = {}
	local v_u_398 = rejag
	local v_u_399 = p377
	local v_u_400 = p378
	local v_u_401 = p370
	local v_u_402 = p371
