return t-- THORN SEEDS tool: a seed that grows a thorny vine to the nearest NPC and wraps around it.
--
--   * A seed falls, lands and sprouts (like SEEDS).
--   * The sprout sends out ONE vine. Every fraction of a second it looks for the nearest living ragdoll and steers
--     towards it, hugging walls and floors and going round obstacles. With no NPC around it wanders and waits.
--   * When the tip touches a body part it starts to WRAP: the vine spirals round that part, then on to the nearest
--     parts, up to MAX_WRAP_PIECES of them. The wrap is stored in each part's own coordinates (Body.localOf /
--     worldOf, like Glue), so it moves with the body. Back strands are drawn behind the body, front strands on top.
--   * A wrapped NPC is held by a leash back to the seed's root and pricked by the thorns (small damage and wounds).
--   * Backspace on any node pulls the plant up. Wheel changes the vine style.
--
-- EXTRA module (like Seeds): Tools.lua calls handles / press / release / deleteAt / drawCursor, and the client calls
-- update every sim tick, drawBack + drawWorld every frame.
local Config = require(script.Parent.Config)
local rgb = Config.rgb
local mix = Config.mix
local readu32 = buffer.readu32
local writeu32 = buffer.writeu32
local floor = math.floor
local ceil = math.ceil
local sin = math.sin
local cos = math.cos
local abs = math.abs
local max = math.max
local min = math.min
local sqrt = math.sqrt
local random = math.random
local atan2 = math.atan2
local PI = math.pi

local t = { NAME = "ThornSeeds" }
t.IDS = { thornseeds = true }
t.LIST = {
	{
		id = "thornseeds",
		tab = "TOOL",
		sec = "OTHER",
		name = "THORN SEEDS",
		desc = "A seed that sprouts a thorny vine. It hunts down the nearest NPC, wraps round them, pins them to the spot and pricks them",
		hint = "CLICK: PLANT A THORN SEED  |  GROWS TO THE NEAREST NPC AND WRAPS IT  |  BKSP: PULL UP A VINE  |  WHEEL VINE STYLE",
		chip = "PLANT THORN SEED",
	},
}

t.MODES = { "ROSE", "IVY", "NIGHT" }

----------------------------------------------------------------- tuning
local STEP = 2 -- pixels between two vine nodes
local GROW_SPEED = 70 -- pixels per second
local TURN = 0.3 -- max steering per step (radians)
local GRAV = 430
local SPROUT_TIME = 0.5
local MAX_SEEDS = 16
local MAX_VINES = 10
local MAX_GROW_NODES = 520
local WANDER_LIFE = 45 -- nodes a vine grows while it has nobody to hunt
local RETARGET = 0.25 -- seconds between looks for the nearest NPC
local REACH = 3 -- px: closer than this to a body part = touching it
local MAX_WRAP_PIECES = 7
local WRAP_SPEED = 30 -- wrap nodes revealed per second
local WRAP_STEP = 0.7 -- radians of spiral per wrap node
local TIGHTEN_TIME = 1.2
local THORN_EVERY = 3 -- a thorn on every n-th node
local PRICK_EVERY = 0.5 -- seconds between thorn pricks on a wrapped NPC
local THORN_DMG = 0.4
local LEASH_SLACK = 28 -- px a wrapped NPC may roam from the root
local LEASH_K = 0.35
local HOLD_MAX = 90 -- seconds a vine keeps holding before it goes limp
local IDLE_MAX = 40

local AIR, BLOOD, ASH = Config.AIR, Config.BLOOD, Config.ASH

local G, World, Body, Phys, Particles, Sfx

local seeds = {}
local vines = {}
local clock = 0

----------------------------------------------------------------- helpers

local function snd(name: string, vol: number, pitch: number)
	if Sfx and Sfx.play then
		Sfx.play(name, vol, pitch)
	end
end

local function flash(text: string)
	local UI = G and G.UI
	if UI and UI.flashHint then
		UI.flashHint(text, Color3.fromRGB(236, 120, 150))
	end
end

local function matAt(x: number, y: number): number
	return World.matAt(floor(x), floor(y))
end

local function isFree(x: number, y: number): boolean
	local m = World.matAt(floor(x), floor(y))
	return m == AIR or m == BLOOD or m == ASH
end

local function angDiff(a: number, b: number): number
	local d = (b - a) % (2 * PI)
	if d > PI then
		d = d - 2 * PI
	end
	return d
end

local function modeNow(): number
	local Tools = G and G.Tools
	local sz = Tools and Tools.SIZES and Tools.SIZES.thornseeds
	local v = sz and sz.value or 1
	return (v >= 1 and v <= #t.MODES) and floor(v) or 1
end

-- a piece we may wrap: alive, attached to a body, has pixels
local function usable(p): boolean
	return p ~= nil and p.alive == true and p.attached ~= false and p.kind ~= "prop" and p.n > 0 and p.pa ~= nil and p.pb ~= nil
end

local function pieceMid(p): (number, number)
	return (Phys.x[p.pa] + Phys.x[p.pb]) * 0.5, (Phys.y[p.pa] + Phys.y[p.pb]) * 0.5
end

local function isNpc(b, strict: boolean): boolean
	if not (b.alive and b.all and #b.all > 0) then
		return false
	end
	if b.sp and b.sp.noFocus then
		return false
	end
	if strict then
		local Folk = Body.Folk
		if Folk and Folk.living then
			return Folk.living(b) and true or false
		end
	end
	return true
end

-- the nearest NPC to (x, y): returns body, nearest-point x, y, distance
local function nearestNpc(x: number, y: number)
	for pass = 1, 2 do -- first living NPCs only, then anybody
		local bestB, bx, by, bd = nil, 0, 0, math.huge
		for _, b in Body.list do
			if isNpc(b, pass == 1) then
				for _, p in b.all do
					if usable(p) then
						local mx, my = pieceMid(p)
						local d = (mx - x) ^ 2 + (my - y) ^ 2
						if d < bd then
							bestB, bx, by, bd = b, mx, my, d
						end
					end
				end
			end
		end
		if bestB then
			return bestB, bx, by, sqrt(bd)
		end
	end
	return nil
end

----------------------------------------------------------------- palettes
-- { stem, stem dark, thorn, thorn tip, bloom, bloom light }
local STYLES = {
	{ rgb(64, 126, 60), rgb(34, 82, 44), rgb(236, 226, 190), rgb(214, 64, 70), rgb(214, 36, 66), rgb(255, 120, 140) }, -- ROSE
	{ rgb(96, 170, 72), rgb(48, 110, 52), rgb(214, 232, 150), rgb(120, 190, 80), rgb(150, 220, 90), rgb(214, 246, 150) }, -- IVY
	{ rgb(70, 40, 96), rgb(34, 20, 56), rgb(204, 196, 230), rgb(170, 90, 240), rgb(120, 60, 200), rgb(190, 140, 255) }, -- NIGHT
}
local MODE_COL = { rgb(236, 80, 110), rgb(120, 200, 90), rgb(150, 90, 230) }
local SEED_BROWN = rgb(70, 42, 40)
local SEED_LIGHT = rgb(180, 120, 110)
local SPROUT = rgb(230, 90, 120)

local function plot(buf: buffer, x: number, y: number, col: number, alpha: number)
	local W, H = Config.W, Config.H
	x, y = floor(x), floor(y)
	if x >= 0 and y >= 0 and x < W and y < H then
		local off = (x + y * W) * 4
		writeu32(buf, off, alpha >= 1 and col or mix(readu32(buf, off), col, alpha))
	end
end

local function line(buf: buffer, x1: number, y1: number, x2: number, y2: number, col: number, alpha: number)
	local dx, dy = x2 - x1, y2 - y1
	local n = max(1, ceil(max(abs(dx), abs(dy))))
	for i = 0, n do
		plot(buf, x1 + dx * i / n, y1 + dy * i / n, col, alpha)
	end
end

----------------------------------------------------------------- vines

local function newVine(x: number, y: number, mode: number)
	while #vines >= MAX_VINES do
		table.remove(vines, 1)
	end
	local V = {
		mode = mode,
		root = { x = x, y = y },
		nodes = {},
		state = "grow", -- grow | idle | wrap | hold | limp
		age = 0,
		stateT = 0,
		look = 0,
		tx = nil,
		ty = nil,
		target = nil,
		ang = -PI / 2,
		acc = 0,
		life = WANDER_LIFE,
		air = 0,
		side = random() < 0.5 and -1 or 1,
		wrap = nil,
		reveal = 0,
		tight = 0,
		prick = 0,
		fade = 1,
	}
	-- find "out of the ground": away from solid cells
	local sx, sy, n = 0, 0, 0
	for d = 0, 15 do
		local a = d * PI / 8
		for r = 2, 4, 2 do
			if not isFree(x + cos(a) * r, y + sin(a) * r) then
				sx, sy, n = sx - cos(a), sy - sin(a), n + 1
			end
		end
	end
	if n > 0 and (abs(sx) > 0.01 or abs(sy) > 0.01) then
		V.ang = atan2(sy, sx)
	end
	table.insert(V.nodes, { x = x, y = y, thorn = 0 })
	table.insert(vines, V)
	snd("grab", 0.3, 0.9)
	return V
end

local function tipNode(V)
	return V.nodes[#V.nodes]
end

-- one growth step; returns false when the tip is boxed in
local function advance(V): boolean
	local cur = tipNode(V)
	local nodes = V.nodes

	local want
	if V.tx then
		want = atan2(V.ty - cur.y, V.tx - cur.x)
	else
		want = V.ang + (random() - 0.5) * 0.8 -- wander, leaning up
		want = want + angDiff(want, -PI / 2) * 0.05
	end
	local d = angDiff(V.ang, want)
	V.ang = V.ang + max(-TURN, min(TURN, d)) + sin(V.age * 6 + #nodes * 0.3) * 0.12 + (random() - 0.5) * 0.15

	-- sag a little in thin air
	local ca, sa = cos(V.ang + PI / 2), sin(V.ang + PI / 2)
	local clinging = not isFree(cur.x + ca * 3, cur.y + sa * 3) or not isFree(cur.x - ca * 3, cur.y - sa * 3)
	if clinging then
		V.air = 0
	else
		V.air = V.air + 1
		V.ang = V.ang + angDiff(V.ang, PI / 2) * min(0.06, 0.004 * V.air)
		V.life = V.life - 0.5
	end

	-- go round whatever is in the way
	local ahead = STEP + 1.5
	local a = V.ang
	if not isFree(cur.x + cos(a) * ahead, cur.y + sin(a) * ahead) then
		local found = false
		for k = 1, 9 do
			for s = 1, 2 do
				local sg = (s == 1) and V.side or -V.side
				local a2 = V.ang + sg * k * 0.3
				if isFree(cur.x + cos(a2) * ahead, cur.y + sin(a2) * ahead) then
					a, found = a2, true
					break
				end
			end
			if found then
				break
			end
		end
		if not found then
			return false
		end
		V.ang = a
	end

	local idx = #nodes + 1
	local n = { x = cur.x + cos(a) * STEP, y = cur.y + sin(a) * STEP, thorn = 0, ang = a }
	if idx % THORN_EVERY == 0 then
		n.thorn = (idx // THORN_EVERY) % 2 == 0 and 1 or -1
		n.tl = 2 + (random() < 0.4 and 1 or 0)
	end
	if idx > 12 and random() < 0.03 then
		n.bud = true
	end
	nodes[idx] = n
	V.life = V.life - 1
	return true
end

----------------------------------------------------------------- wrapping

-- build the spiral for one piece, entering from the end nearest to (px, py)
local function spiral(list, p, px: number, py: number)
	local u0, u1 = p.gu0, p.gu0 + p.gw - 1
	local hw = p.gh * 0.5
	local vc = p.gv0 + (p.gh - 1) * 0.5
	local ax, ay = Body.worldOf(p, u0, vc)
	local bx, by = Body.worldOf(p, u1, vc)
	local from, to = u0, u1
	if (bx - px) ^ 2 + (by - py) ^ 2 < (ax - px) ^ 2 + (ay - py) ^ 2 then
		from, to = u1, u0
	end
	local len = abs(to - from)
	local turns = max(1.5, min(3.5, len / max(1.5, hw * 2.2)))
	local count = max(4, ceil(turns * 2 * PI / WRAP_STEP))
	local phase = random() * PI * 2
	for i = 0, count do
		local s = i / count
		local th = phase + s * turns * 2 * PI
		local node = {
			p = p,
			u = from + (to - from) * s,
			vc = vc,
			hw = hw,
			th = th,
			front = cos(th) >= 0,
		}
		if i % 2 == 0 then
			node.thorn = true
		end
		table.insert(list, node)
	end
end

local function wrapPos(V, n): (number, number)
	local k = 1.2 - 0.7 * V.tight -- loose at first, then it cinches in
	return Body.worldOf(n.p, n.u, n.vc + (n.hw + k) * sin(n.th))
end

local function startWrap(V, hit)
	local body = hit.body
	if not body then
		return false
	end
	local cands = {}
	for _, p in body.all do
		if usable(p) and p.gw >= 4 then
			table.insert(cands, p)
		end
	end
	if not usable(hit) or hit.gw < 4 then
		-- the touched bit is too small to coil on: start with the nearest big piece instead
		local tip = tipNode(V)
		local best, bd = nil, math.huge
		for _, p in cands do
			local mx, my = pieceMid(p)
			local d = (mx - tip.x) ^ 2 + (my - tip.y) ^ 2
			if d < bd then
				best, bd = p, d
			end
		end
		hit = best
	end
	if not hit then
		return false
	end
	local list, pieces, used = {}, { hit }, { [hit] = true }
	local tip = tipNode(V)
	spiral(list, hit, tip.x, tip.y)
	local cur = hit
	while #pieces < MAX_WRAP_PIECES do
		local cx, cy = pieceMid(cur)
		local best, bd = nil, math.huge
		for _, p in cands do
			if not used[p] then
				local mx, my = pieceMid(p)
				local d = (mx - cx) ^ 2 + (my - cy) ^ 2
				if d < bd then
					best, bd = p, d
				end
			end
		end
		if not best then
			break
		end
		used[best] = true
		table.insert(pieces, best)
		local last = list[#list]
		local lx, ly = Body.worldOf(last.p, last.u, last.vc)
		spiral(list, best, lx, ly)
		cur = best
	end
	V.wrap = { body = body, pieces = pieces, list = list }
	V.reach = sqrt((tip.x - V.root.x) ^ 2 + (tip.y - V.root.y) ^ 2) + LEASH_SLACK
	V.state = "wrap"
	V.stateT = 0
	V.reveal = 0
	V.tight = 0
	snd("grab", 0.45, 0.6)
	return true
end

local function pruneWrap(V): number -- how many wrap pieces are still usable
	local w = V.wrap
	local c = 0
	for _, p in w.pieces do
		if usable(p) and p.body == w.body and w.body.alive then
			c = c + 1
		end
	end
	return c
end

local function leash(V)
	local w = V.wrap
	local rx, ry = V.root.x, V.root.y
	local X, Y, OX, OY = Phys.x, Phys.y, Phys.ox, Phys.oy
	local drag, drag2 = Phys.drag.p, Phys.drag.p2
	for _, p in w.pieces do
		if usable(p) then
			for _, pt in { p.pa, p.pb } do
				if Phys.alive[pt] == 1 and Phys.im[pt] > 0 and pt ~= drag and pt ~= drag2 then
					local dx, dy = X[pt] - rx, Y[pt] - ry
					local d = sqrt(dx * dx + dy * dy)
					local over = d - V.reach
					if over > 0 and d > 0.001 then
						local nx, ny = dx / d, dy / d
						local c = min(over * LEASH_K, 3)
						X[pt] = X[pt] - nx * c
						Y[pt] = Y[pt] - ny * c
						OX[pt] = OX[pt] - nx * c
						OY[pt] = OY[pt] - ny * c
						-- take out the outward speed
						local vn = (X[pt] - OX[pt]) * nx + (Y[pt] - OY[pt]) * ny
						if vn > 0 then
							OX[pt] = OX[pt] + nx * vn * 0.5
							OY[pt] = OY[pt] + ny * vn * 0.5
						end
					end
				end
			end
		end
	end
end

local function pricks(V)
	local w = V.wrap
	local shown = min(#w.list, floor(V.reveal))
	if shown < 1 then
		return
	end
	local hurt = {}
	for _ = 1, 3 do
		local n = w.list[random(1, shown)]
		if n.thorn and usable(n.p) then
			local x, y = wrapPos(V, n)
			if Body.woundAt then
				Body.woundAt(n.p, x, y, 1.0, 1.1)
			end
			if Particles and Particles.bloodBurst then
				Particles.bloodBurst(x, y, 1, 30)
			end
			hurt[n.p] = true
		end
	end
	for p in hurt do
		Body.hurtPiece(p, THORN_DMG * 2)
	end
	for _, p in w.pieces do
		if usable(p) and not hurt[p] then
			Body.hurtPiece(p, THORN_DMG * 0.5)
		end
	end
	snd("click", 0.12, 1.8 + random() * 0.5)
end

local function updateVine(V, dt: number): boolean -- false = remove
	V.age = V.age + dt
	V.stateT = V.stateT + dt

	if V.state == "grow" or V.state == "idle" then
		V.look = V.look - dt
		if V.look <= 0 then
			V.look = RETARGET
			local b, x, y = nearestNpc(tipNode(V).x, tipNode(V).y)
			V.target, V.tx, V.ty = b, x, y
			if b and V.state == "idle" and #V.nodes < MAX_GROW_NODES then
				V.state = "grow"
				V.life = 220
				V.stateT = 0
			end
		end
		if V.state == "idle" then
			if V.stateT > IDLE_MAX then
				V.state = "limp"
				V.stateT = 0
			end
			return true
		end

		-- touching an NPC? start wrapping
		local tip = tipNode(V)
		local hit = Body.pieceNear(tip.x, tip.y, REACH)
		if hit and hit.body and isNpc(hit.body, false) and V.age > 0.4 then
			if startWrap(V, hit) then
				return true
			end
		end

		V.acc = V.acc + GROW_SPEED * dt
		while V.acc >= STEP and V.state == "grow" do
			V.acc = V.acc - STEP
			if #V.nodes >= MAX_GROW_NODES or V.life <= 0 or not advance(V) then
				V.state = "idle"
				V.stateT = 0
				V.look = 0
			end
		end
	elseif V.state == "wrap" or V.state == "hold" then
		local w = V.wrap
		if pruneWrap(V) == 0 then
			V.state = "limp"
			V.stateT = 0
			return true
		end
		if V.state == "wrap" then
			V.reveal = V.reveal + WRAP_SPEED * dt
			if V.reveal >= #w.list then
				V.reveal = #w.list
				V.state = "hold"
				V.stateT = 0
				snd("click", 0.4, 0.5)
			end
		else
			V.tight = min(1, V.tight + dt / TIGHTEN_TIME)
			if V.stateT > HOLD_MAX then
				V.state = "limp"
				V.stateT = 0
			end
		end
		leash(V)
		V.prick = V.prick - dt
		if V.prick <= 0 then
			V.prick = PRICK_EVERY
			pricks(V)
		end
	else -- limp: fade out
		V.fade = V.fade - dt / 4
		if V.fade <= 0 then
			return false
		end
	end
	return true
end

----------------------------------------------------------------- seeds

local function dropSeed(x: number, y: number)
	if not isFree(x, y) then
		return nil
	end
	while #seeds >= MAX_SEEDS do
		table.remove(seeds, 1)
	end
	local s = { x = x, y = y, vx = (random() - 0.5) * 12, vy = 0, mode = modeNow(), state = "fall", t = 0 }
	table.insert(seeds, s)
	return s
end

local function updateSeed(s, dt: number): boolean
	if s.state == "fall" then
		s.vy = s.vy + GRAV * dt
		local nx, ny = s.x + s.vx * dt, s.y + s.vy * dt
		local steps = max(1, ceil(max(abs(nx - s.x), abs(ny - s.y))))
		local sx, sy = s.x, s.y
		for i = 1, steps do
			local px, py = sx + (nx - sx) * i / steps, sy + (ny - sy) * i / steps
			if isFree(px, py) then
				s.x, s.y = px, py
			else
				s.state = "rest"
				break
			end
		end
		if s.y > Config.H + 4 or s.x < -4 or s.x > Config.W + 4 then
			return false
		end
	else
		s.t = s.t + dt
		if s.t >= SPROUT_TIME then
			s.vine = newVine(s.x, s.y, s.mode)
			return false
		end
	end
	return true
end

----------------------------------------------------------------- the EXTRA-module interface

function t.handles(id: string): boolean
	return t.IDS[id] == true
end

function t.press(id: string)
	if id ~= "thornseeds" then
		return
	end
	local x, y = G.Tools.mouse()
	local s = dropSeed(x, y)
	if not s then
		flash("CAN'T PLANT INSIDE A WALL")
		return
	end
	snd("click", 0.3, 1.1)
	local Arsenal = G.Arsenal
	if Arsenal and Arsenal.remember then
		Arsenal.remember(function()
			local i = table.find(seeds, s)
			if i then
				table.remove(seeds, i)
				return true
			end
			local j = s.vine and table.find(vines, s.vine)
			if j then
				table.remove(vines, j)
				return true
			end
			return false
		end, "THORN SEEDS")
	end
end

function t.release(_id: string) end

function t.update(dt: number)
	clock = clock + dt
	for i = #seeds, 1, -1 do
		if not updateSeed(seeds[i], dt) then
			table.remove(seeds, i)
		end
	end
	for i = #vines, 1, -1 do
		if not updateVine(vines[i], dt) then
			table.remove(vines, i)
		end
	end
end

function t.deleteAt(x: number, y: number): boolean
	local hit = false
	for i = #vines, 1, -1 do
		local V = vines[i]
		local found = false
		for _, n in V.nodes do
			if (n.x - x) ^ 2 + (n.y - y) ^ 2 <= 49 then
				found = true
				break
			end
		end
		if not found and V.wrap then
			for k = 1, min(#V.wrap.list, floor(V.reveal)) do
				local n = V.wrap.list[k]
				if usable(n.p) then
					local wx, wy = wrapPos(V, n)
					if (wx - x) ^ 2 + (wy - y) ^ 2 <= 49 then
						found = true
						break
					end
				end
			end
		end
		if found then
			table.remove(vines, i)
			hit = true
		end
	end
	for i = #seeds, 1, -1 do
		local s = seeds[i]
		if (s.x - x) ^ 2 + (s.y - y) ^ 2 <= 49 then
			table.remove(seeds, i)
			hit = true
		end
	end
	if hit then
		snd("click", 0.4, 0.8)
	end
	return hit
end

function t.clear()
	table.clear(seeds)
	table.clear(vines)
end

function t.count(): number
	return #vines
end

function t.debug(): string
	local wrapped = 0
	for _, V in vines do
		if V.state == "wrap" or V.state == "hold" then
			wrapped = wrapped + 1
		end
	end
	return string.format("thornseeds=%d vines=%d wrapped=%d", #seeds, #vines, wrapped)
end

function t.init(game)
	G = game
	World = game.World
	Body = game.Body
	Phys = game.Phys
	Particles = game.Particles
	Sfx = game.Sfx
end

----------------------------------------------------------------- drawing

local function drawGrowNodes(buf: buffer, V, pal, a: number)
	local nodes = V.nodes
	for i = 1, #nodes do
		local n = nodes[i]
		local col = (i % 2 == 0) and pal[1] or pal[2]
		if i > 1 then
			local pn = nodes[i - 1]
			line(buf, pn.x, pn.y, n.x, n.y, col, a)
		end
		if i < 14 then
			plot(buf, n.x + 1, n.y, pal[2], a) -- thicker near the root
		end
		if n.thorn ~= 0 and n.ang then
			local px, py = -sin(n.ang) * n.thorn, cos(n.ang) * n.thorn
			for r = 1, n.tl do
				plot(buf, n.x + px * r, n.y + py * r, r == n.tl and pal[4] or pal[3], a)
			end
		end
		if n.bud then
			plot(buf, n.x, n.y - 1, pal[5], a)
			plot(buf, n.x, n.y - 2, pal[6], a)
		end
	end
end

-- front = true draws the strands in front of the body, false the ones behind it
local function drawWrap(buf: buffer, V, pal, front: boolean, a: number)
	local w = V.wrap
	if not w then
		return
	end
	local list = w.list
	local shown = min(#list, floor(V.reveal))
	local px, py, pOk, pFront
	for i = 1, shown do
		local n = list[i]
		if usable(n.p) then
			local x, y = wrapPos(V, n)
			if n.front == front then
				if pOk and pFront == front then
					line(buf, px, py, x, y, front and pal[1] or pal[2], a)
				end
				plot(buf, x, y, (i % 2 == 0) and pal[1] or pal[2], a)
				if n.thorn then
					-- thorn points out of the limb, away from its axis
					local ox, oy = Body.worldOf(n.p, n.u, n.vc + (n.hw + 3) * sin(n.th))
					plot(buf, (x + ox) * 0.5, (y + oy) * 0.5, pal[3], a)
					plot(buf, ox, oy, front and pal[4] or pal[3], a * (front and 1 or 0.7))
				end
			end
			px, py, pOk, pFront = x, y, true, n.front
		else
			pOk = false
		end
	end
end

function t.drawBack(buf: buffer)
	for _, V in vines do
		if V.wrap then
			drawWrap(buf, V, STYLES[V.mode] or STYLES[1], false, V.fade)
		end
	end
end

function t.drawWorld(buf: buffer)
	for _, V in vines do
		local pal = STYLES[V.mode] or STYLES[1]
		drawGrowNodes(buf, V, pal, V.fade)
		if V.wrap then
			drawWrap(buf, V, pal, true, V.fade)
			-- a bloom at the knot once it holds
			if V.state == "hold" then
				local last = V.wrap.list[#V.wrap.list]
				if last and usable(last.p) then
					local x, y = wrapPos(V, last)
					plot(buf, x, y - 1, pal[5], V.fade)
					plot(buf, x - 1, y, pal[6], V.fade)
					plot(buf, x + 1, y, pal[6], V.fade)
					plot(buf, x, y + 1, pal[5], V.fade)
					plot(buf, x, y, pal[4], V.fade)
				end
			end
		end
	end
	for _, s in seeds do
		plot(buf, s.x, s.y, SEED_BROWN, 1)
		plot(buf, s.x, s.y - 1, SEED_LIGHT, 1)
		if s.state == "rest" and s.t / SPROUT_TIME > 0.4 then
			plot(buf, s.x, s.y - 1, SPROUT, 1)
			plot(buf, s.x - 1, s.y - 2, SPROUT, 1)
			plot(buf, s.x + 1, s.y - 2, SPROUT, 1)
		end
	end
end

-- cursor: dotted drop line, plus a line to the NPC the vine would hunt
function t.drawCursor(buf: buffer, id: string)
	if id ~= "thornseeds" then
		return
	end
	local Tools = G.Tools
	local x, y = Tools.mouse()
	Tools.cursorWant = MODE_COL[modeNow()]
	local cx, cy = floor(x), floor(y)
	if not isFree(cx, cy) then
		return
	end
	local yy, steps = cy, 0
	while steps < 170 and isFree(cx, yy + 1) do
		yy = yy + 1
		steps = steps + 1
	end
	for k = 5, steps, 4 do
		plot(buf, cx, cy + k, SPROUT, 0.45)
	end
	for i = -2, 2 do
		plot(buf, cx + i, yy + 1, SPROUT, 0.8)
	end
	local b, tx, ty = nearestNpc(cx, yy)
	if b then
		local dx, dy = tx - cx, ty - yy
		local n = max(1, floor(sqrt(dx * dx + dy * dy) / 5))
		for i = 1, n do
			plot(buf, cx + dx * i / n, yy + dy * i / n, MODE_COL[modeNow()], 0.35)
		end
		for i = -2, 2 do
			plot(buf, tx + i, ty - 6, MODE_COL[modeNow()], 0.7)
			plot(buf, tx, ty - 6 + i, MODE_COL[modeNow()], 0.7)
		end
	end
end

return t




local v1 = script
if typeof(v1) == "Instance" then
	script:SetAttribute("Notice", "test")
end
local t = {}
local v_u_2 = nil
local floor = math.floor
local min = math.min
local max = math.max
local random = math.random
local readu8 = buffer.readu8
local writeu8 = buffer.writeu8
t.after = 0
t.cleared = 0
local t2 = {}
function t.init(p3)
	
	if t2[0] then
		return
	end
	v_u_2 = p3
end
local function loose(p4)
	
	if not p4.alive or (p4.attached or p4.kind == "prop") then
		return false
	end
	local body = p4.body
	return (not body or not body.held and (not body.mPull and body.parts.chest)) and true or false
end
local t3 = {}
local t4 = {}
local v_u_5 = t
local function fade(p6)
	
	if t4[0] then
		return
	end
	local Body = v_u_2.Body
	local worldOf = Body.worldOf
	local v7 = (p6.rest or 0) * 0.5
	local v8, v9, v10 = pcall(worldOf, p6, v7, 0)
	Body.retire(p6)
	local v11 = v_u_5
	v11.cleared = v11.cleared + 1
	if v8 and (v9 and (v_u_2.Particles and v_u_2.Particles.smoke)) then
		v_u_2.Particles.smoke(v9, v10, 2, 3)
	end
end
local t5 = {}
local v_u_12 = floor
local v_u_13 = min
local v_u_14 = t
local function sweepGore(p15: number)
	
	if t5[0] then
		return
	end
	local World = v_u_2.World
	local C = v_u_2.C
	local mat = World.mat
	local aux = World.aux
	local W = C.W
	local H = C.H
	local GIB = C.GIB
	local v16 = H - 2 - 6
	if not (v16 < 1) then
		local v17 = p15 < 0.1
		local v18 = v17 and 1 or v_u_13(250, (max(2, (v_u_12(p15 * 60 * 6 / v16 + 0.5)))))
		for _ = 1, v17 and 6 or 1 do
			local v19 = v_u_12(random() * v16) + 1
			for v20 = v19, v19 + 6 - 1 do
				local v21 = v20 * W
				for v22 = 1, W - 2 do
					local v23 = v21 + v22
					if readu8(mat, v23) == GIB then
						local v24 = readu8(aux, v23) + 1
						if v18 <= v24 then
							World.clear(v22, v20)
							local v25 = v_u_14
							v25.cleared = v25.cleared + 1
						else
							writeu8(aux, v23, v24)
						end
					end
				end
			end
		end
	end
end
local t6 = {}
function t.sweepNow()
	
	if t6[0] then
		return
	end
	if not v_u_2 then
		return 0
	end
	local v26 = 0
	for _2, v27 in table.clone(v_u_2.Body.pieces) do
		local v28
		if v27.alive and (not v27.attached and v27.kind ~= "prop") then
			local body2 = v27.body
			v28 = (not body2 or not body2.held and (not body2.mPull and body2.parts.chest)) and true or false
		else
			v28 = false
		end
		if v28 then
			fade(v27)
			v26 = v26 + 1
		end
	end
	return v26
end
local t7 = {}
local v_u_29 = t
function t.step(p30: number)
	
	if t7[0] then
		return
