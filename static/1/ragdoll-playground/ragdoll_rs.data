		local function drawDrillAt(p655: buffer, p656: number, p657: number, p658: number, p659: number, p660: number, p661: number, p662: number)
			
			local v663: number = -p659
			local v664: number = v663 * -0.7 + p658 * -0.7
			local v665 = p656 + p658 * p660
			local v666 = p657 + p659 * p660
			local v667 = max(1, (floor(min(p656, v665) - p661 - 3)))
			local v668: number = min(v_u_653 - 2, (floor(max(p656, v665) + p661 + 3)))
			local v669 = p658
			for v670 = max(1, (floor(min(p657, v666) - p661 - 3))), min(v_u_654 - 2, (floor(max(p657, v666) + p661 + 3))) do
				for v671 = v667, v668 do
					local v672 = v671 + 0.5 - p656
					local v673 = v670 + 0.5 - p657
					local v674 = v672 * p658 + v673 * p659
					if v674 >= -2.5 and v674 <= p660 + 1 then
						local v675 = abs(v672 * v663 + v673 * v669)
						local v676 = v674 < 0 and p661 * 0.8 or p661 * (1 - v674 / p660) ^ 0.85
						if v675 <= v676 + 1 then
							local v677
							if v676 < v675 or (v674 < -1.5 or p660 < v674) then
								v677 = v_u_596
							elseif v674 < 0 then
								v677 = (v672 * v663 + v673 * v669) * v664 > 0 and v_u_594 or v_u_595
							else
								local v678 = v672 * v663 + v673 * v669
								if (v674 * 0.42 + v678 / max(v676, 0.7) * 1.25 - p662) % 3 < 0.62 then
