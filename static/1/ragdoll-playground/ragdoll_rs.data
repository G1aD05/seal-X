local floor = math.floor
local sqrt = math.sqrt
local atan2 = math.atan2
local max = math.max
local min = math.min
local _ = math.abs
local v_u_2 = floor
local function pack(p3)
	
	return v_u_2(p3[1]) + v_u_2(p3[2]) * 256 + v_u_2(p3[3]) * 65536 + 4278190080
end
local function lerp3(p4, p5, p6)
	
	return { p4[1] + (p5[1] - p4[1]) * p6, p4[2] + (p5[2] - p4[2]) * p6, p4[3] + (p5[3] - p4[3]) * p6 }
end
local t3 = {}
local function grid()
	
	return (table.create(256, false))
end
local v_u_7 = floor
t3.saw = function()
	
	local v8 = table.create(256, false)
	for v9 = 0, 15 do
		for v10 = 0, 15 do
			local v11 = v10 - 7.5
			local v12 = v9 - 7.5
			local v13 = sqrt(v11 * v11 + v12 * v12)
			local v14 = v_u_7((atan2(v12, v11) / 6.283185307179586 + 1) * 12 * 2) % 2 == 0
			local v15 = nil
			if v13 <= 1.6 then
				v15 = t2.h
			elseif v13 <= 2.6 then
				v15 = t2.k
			elseif v13 <= 5.2 then
				local v16 = 0.5 - (v11 + v12) / 12
				local v17 = math.clamp(v16, 0, 1)
				v15 = lerp3(t2.g, t2.w, v17)
			elseif v13 <= 6.1 then
				local v18 = lerp3
				local D = t2.D
				local l = t2.l
				local v19 = 0.5 - (v11 + v12) / 14
				v15 = v18(D, l, (math.clamp(v19, 0, 1)))
			elseif v13 <= 7.6 and v14 then
				v15 = v13 > 6.9 and t2.k or t2.l
			elseif v13 <= 6.6 then
				v15 = t2.k
			end
			v8[v9 * 16 + v10 + 1] = v15 or false
		end
	end
	return v8
end
local v_u_20 = floor
t3.settings = function()
	
	local v21 = table.create(256, false)
	for v22 = 0, 15 do
		for v23 = 0, 15 do
			local v24 = v23 - 7.5
			local v25 = v22 - 7.5
			local v26 = sqrt(v24 * v24 + v25 * v25)
			local v27 = v_u_20((atan2(v25, v24) / 6.283185307179586 + 1) * 16 + 0.25) % 2 == 0 and 7.4 or 5.8
			local v28 = nil
			if v26 <= 2.2 then
				v28 = nil
			elseif v26 <= 3.1 then
				v28 = t2.k
			elseif v26 <= v27 - 1 then
				local v29 = lerp3
				local g = t2.g
				local w = t2.w
				local v30 = 0.5 - (v24 + v25) / 12
				v28 = v29(g, w, (math.clamp(v30, 0, 1)))
			elseif v26 <= v27 then
				v28 = t2.k
			end
			v21[v22 * 16 + v23 + 1] = v28 or false
		end
	end
	return v21
end
