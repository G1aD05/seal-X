local t5 = { music = true, roomtone = true, dance = true }
t.BG = { LOW = 0.5, MID = 1, HIGH = 1.8 }
t.bgLevel = "LOW"
t.musicOn = true
function t.ambient(p2: boolean)
	
	t.prime()
	t.musicOn = p2 and t.bgLevel ~= "OFF"
	t.loop("music", t.musicOn, t.BG[t.bgLevel])
	t.loop("roomtone", t.musicOn)
end
function t.setBackground(p3: string)
	
	if p3 == "OFF" or t.BG[p3] then
		t.bgLevel = p3
		t.ambient(p3 ~= "OFF")
	end
end
local t6 = {}
local t7 = {}
local v_u_4, v_u_5, v_u_6 = nil
local v_u_7 = false
local t8 = {}
function t.duck(p8: boolean)
	
	if t8[0] then
		return
	end
	if p8 ~= v_u_7 then
		v_u_7 = p8
		local music = t7.music
		if music then
			music.Volume = p8 and 0 or t.IDS.music[2] * (t.BG[t.bgLevel] or 1)
		end
	end
end
local t9 = {}
local function tune(p9: string)
	
	local v10 = t.IDS[p9]
	if not t9[p9] and v10 then
		t9[p9] = true
		local v11 = t2[p9]
		if v11 and v11.v then
			v10[2] = v11.v
			v10[3] = v11.e
			v10[4] = v11.s
		end
	end
end
local t10 = {}
local function newSound(p12: string, p13)
	
	if t10[0] then
		return
	end
	local Sound = Instance.new("Sound")
	Sound.SoundId = p13[1]
	Sound.Volume = 0
	Sound.SoundGroup = t5[p12] and v_u_6 or v_u_5
	return Sound
end
local t11 = {}
local function pool(p14: string)
	
	if t11[0] then
		return
	end
	local v15 = t6[p14]
	if v15 then
		return v15
	end
	local v16 = t.IDS[p14]
	if not (v16 and v_u_4) then
		return nil
	end
	local v17 = t.IDS[p14]
	if not t9[p14] and v17 then
		t9[p14] = true
		local v18 = t2[p14]
		if v18 and v18.v then
			v17[2] = v18.v
			v17[3] = v18.e
			v17[4] = v18.s
		end
	end
	local v19 = t2[p14]
	local t12 = {
		i = 0,
		list = 0,
		list = {}
	}
	for v20 = 1, t4[p14] or t3[v19 and v19.k or "hit"].pool do
		local Sound2 = Instance.new("Sound")
		Sound2.SoundId = v16[1]
		Sound2.Volume = 0
		Sound2.SoundGroup = t5[p14] and v_u_6 or v_u_5
		Sound2.Name = p14 .. v20
		if v16[3] then
			Sound2.PlaybackRegionsEnabled = true
			Sound2.PlaybackRegion = NumberRange.new(v16[4] or 0, v16[3])
		end
		Sound2.Parent = v_u_4
		t12.list[v20] = Sound2
	end
	t6[p14] = t12
	return t12
end
local function prepLoop(p21: userdata, p22: string)
	
	local v23 = t.IDS[p22]
	local v24 = t2[p22]
	local v25, v26 = nil
	if v24 and v24.loop then
		v25 = v24.loop[1]
		v26 = v24.loop[2]
	elseif v23[3] or v23[4] then
		v25 = v23[4] or 0
		v26 = v23[3] or 600
	end
	p21.Looped = true
	if v25 then
		p21.PlaybackRegionsEnabled = true
		p21.PlaybackRegion = NumberRange.new(v25, v26)
		p21.LoopRegion = NumberRange.new(v25, v26)
		p21.TimePosition = v25
	end
end
local t13 = {}
function t.newLoop(p27: string)
	
	if t13[0] then
		return
	end
	local v28 = t.IDS[p27]
	if not (v28 and v_u_4) then
		return nil
	end
	local v29 = t.IDS[p27]
	if not t9[p27] and v29 then
