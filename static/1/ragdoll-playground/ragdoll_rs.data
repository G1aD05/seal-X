return t-- CursorChat: press ENTER while you are in an online room to open a small chat box next to your cursor.
-- Everybody in the room sees what you type LIVE, in a box that follows your cursor. ENTER sends it (it stays
-- for a few seconds, then fades), ESC or a click elsewhere closes it.
--
-- The server (TTOServer, "cc") only relays: mode "o" = still typing (text so far), "f" = sent, "x" = closed.
-- Other players' cursor positions come from Net.cursorSpots(), so the box rides on the same cursors as the name tags.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local t = {}
local g

local MAX_CHARS = 48 -- the server cuts at the same length
local LINGER = 6 -- seconds a sent message stays
local FADE = 1 -- seconds it takes to fade out
local STALE = 30 -- a typing box nobody has heard about for this long is dropped (the player probably left)
local SEND_GAP = 0.1 -- at most 10 typing updates a second
local FONT = Font.new("rbxasset://fonts/families/PressStart2P.json")
local INK = Color3.fromRGB(14, 16, 28)
local GREY = Color3.fromRGB(141, 148, 178)

local gui -- holds my own box
local mine = nil -- my box: { mode = "typing" | "sent" | "note", b, text, t0, life, seat, U, last, sentAt, dirty }
local states = {} -- [seat] = { mode = "o" | "f", text, t } what other players are typing or just sent
local bubbles = {} -- [seat] = { b, holder } the boxes drawn for them

local function clean(s)
	s = string.gsub(tostring(s or ""), "[^\32-\126]", "")
	return string.sub(s, 1, MAX_CHARS)
end

local function uScale()
	local X = g.UI and g.UI.X
	return X and X.U and X.U() or 2
end

local function myEntry()
	for _, p in g.Net.players or {} do
		if p.id == Players.LocalPlayer.UserId then
			return p
		end
	end
	return nil
end

-- chat only means something when somebody else shares your room: you host guests, or you are a guest
local function inRoom()
	local me = myEntry()
	return me ~= nil and (me.host ~= nil or (me.guests or 0) > 0)
end

local function mySeat()
	local _, slot = g.Net.inRoom()
	return slot or 0
end

local function send(mode, text)
	local net = ReplicatedStorage:FindFirstChild("TTONet")
	if net then
		net:FireServer("cc", mode, text)
	end
end

------------------------------------------------------------ the box

local function makeBubble(parent, editable)
	local b = { editable = editable }
	local outer = Instance.new("Frame")
	outer.Name = "CursorChat"
	outer.BorderSizePixel = 0
	outer.ZIndex = 40
	local inner = Instance.new("Frame")
	inner.Name = "Plate"
	inner.BorderSizePixel = 0
	inner.BackgroundColor3 = INK
	inner.ZIndex = 41
	local label
	if editable then
		label = Instance.new("TextBox")
		label.ClearTextOnFocus = false
		label.TextEditable = true
		label.MultiLine = false
		label.PlaceholderText = ""
		label:SetAttribute("Caret", true)
	else
		label = Instance.new("TextLabel")
	end
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.FontFace = FONT
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.TextWrapped = false
	label.Text = ""
	label.ZIndex = 42
	local caret = Instance.new("Frame")
	caret.Name = "Caret"
	caret.BorderSizePixel = 0
	caret.BackgroundColor3 = Color3.new(1, 1, 1)
	caret.ZIndex = 42
	caret.Visible = false
	outer.Parent = parent
	inner.Parent = outer
	label.Parent = outer
	caret.Parent = outer
	b.outer, b.inner, b.label, b.caret = outer, inner, label, caret
	return b
end

local function destroyBubble(b)
	if b and b.outer then
		-- a destroyed TextBox must not stay "focused": the game would think the player is still typing and
		-- ignore every key. Let go of the focus first (the caller has already cleared `mine`, so the
		-- FocusLost handler ignores this).
		if b.editable and b.label then
			pcall(function()
				if b.label:IsFocused() then
					b.label:ReleaseFocus()
				end
			end)
		end
		b.outer:Destroy()
		b.outer = nil
	end
end

-- sizes the box around the text and colours it; alpha 1 = fully shown
local function paint(b, text, color, U, showCaret, alpha)
	if not b.outer then
		return
	end
	local size = 7 * U
	local bw = math.max(1, U)
	local padX, padY = 3 * U, 2 * U
	local label = b.label
	label.TextSize = size
	if not b.editable then
		label.Text = text
	end
	local tw = label.TextBounds.X
	local textW = math.max(tw, 24 * U - 2 * padX)
	local W = math.floor(textW + 2 * padX + 2 * bw + (b.editable and 6 * U or 2 * U))
	local H = math.floor(size + 2 * padY + 2 * bw)
	b.W, b.H = W, H
	b.outer.Size = UDim2.fromOffset(W, H)
	b.outer.BackgroundColor3 = color
	b.inner.Position = UDim2.fromOffset(bw, bw)
	b.inner.Size = UDim2.fromOffset(W - 2 * bw, H - 2 * bw)
	label.Position = UDim2.fromOffset(bw + padX, bw + padY)
	label.Size = UDim2.fromOffset(W - 2 * (bw + padX) + 6 * U, size)
	b.outer.BackgroundTransparency = 1 - alpha
	b.inner.BackgroundTransparency = 1 - 0.88 * alpha
	label.TextTransparency = 1 - alpha
	local blink = math.floor(os.clock() * 2) % 2 == 0
	b.caret.Visible = showCaret and blink and not b.editable
	b.caret.Position = UDim2.fromOffset(bw + padX + tw + U, bw + padY)
	b.caret.Size = UDim2.fromOffset(U, size)
	b.caret.BackgroundTransparency = 1 - alpha
end

-- puts the box just under and right of a cursor at (cx, cy); keeps it inside (bw, bh) by flipping to the other side
local function place(b, cx, cy, bw, bh, U)
	if not b.outer then
		return
	end
	local x = cx + 5 * U
	local y = cy + 14 * U
	if x + b.W > bw then
		x = cx - b.W - 2 * U
	end
	if y + b.H > bh then
		y = cy - b.H - 2 * U
	end
	b.outer.Position = UDim2.fromOffset(math.floor(math.max(0, x)), math.floor(math.max(0, y)))
end

-- how visible a message is: 1 while it is fresh, fading to 0 over FADE seconds after `life`
local function fadeOf(age, life)
	if age <= life then
		return 1
	end
	return 1 - (age - life) / FADE
end

------------------------------------------------------------ my own box

-- `mine` is cleared BEFORE the box is destroyed, so letting go of the TextBox's focus cannot call back into us
local function closeMine()
	local m = mine
	mine = nil
	if m then
		destroyBubble(m.b)
	end
end

local function onFocusLost(b, enter)
	if not (mine and mine.b == b) then
		return
	end
	local text = string.match(clean(b.label.Text), "^%s*(.-)%s*$")
	if enter and text ~= "" then
		local seat, U = mine.seat, mine.U
		send("f", text)
		mine = nil
		destroyBubble(b)
		mine = { mode = "sent", b = makeBubble(gui, false), text = text, t0 = os.clock(), life = LINGER, seat = seat, U = U }
	else
		send("x")
		closeMine()
	end
end

local function openBox()
	closeMine()
	local b = makeBubble(gui, true)
	mine = { mode = "typing", b = b, text = "", last = "", sentAt = 0, dirty = false, seat = mySeat(), U = uScale() }
	b.label.FocusLost:Connect(function(enter)
		onFocusLost(b, enter)
	end)
	b.label:CaptureFocus()
	send("o", "")
	mine.sentAt = os.clock()
end

local function showNote(text)
	closeMine()
	mine = { mode = "note", b = makeBubble(gui, false), text = text, t0 = os.clock(), life = 2, seat = 0, U = uScale() }
end

local function colorOf(seat)
	return g.Hands.COLORS[seat] or g.Hands.COLORS[1]
end

local function stepMine(now)
	local m = mine
	local mp = UserInputService:GetMouseLocation()
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	if m.mode == "typing" then
		local tb = m.b.label
		local text = clean(tb.Text)
		if text ~= tb.Text then
			tb.Text = text
		end
		if text ~= m.last then
			m.last = text
			m.dirty = true
		end
		if m.dirty and now - m.sentAt >= SEND_GAP then
			send("o", text)
			m.sentAt = now
			m.dirty = false
		end
		paint(m.b, text, colorOf(m.seat), m.U, false, 1)
	else
		local age = now - m.t0
		if age > m.life + FADE then
			closeMine()
			return
		end
		paint(m.b, m.text, m.mode == "note" and GREY or colorOf(m.seat), m.U, false, fadeOf(age, m.life))
	end
	place(m.b, mp.X, mp.Y, vp.X, vp.Y, m.U)
end

------------------------------------------------------------ other players' boxes

local function onChat(userId, data)
	if type(data) ~= "table" then
		return
	end
	local seat = data.s
	if type(seat) ~= "number" then
		return
	end
	if data.m == "o" or data.m == "f" then
		states[seat] = { mode = data.m, text = clean(data.t), t = os.clock() }
	else
		states[seat] = nil
		if bubbles[seat] then
			destroyBubble(bubbles[seat].b)
			bubbles[seat] = nil
		end
	end
end

local function stepOthers(now)
	if next(states) == nil and next(bubbles) == nil then
		return
	end
	local bySlot = {}
	if g.Net.cursorSpots then
		for _, spot in g.Net.cursorSpots() do
			bySlot[spot.slot] = spot
		end
	end
	for seat, st in states do
		local age = now - st.t
		if (st.mode == "f" and age > LINGER + FADE) or (st.mode == "o" and age > STALE) then
			states[seat] = nil
		end
	end
	for seat, bub in bubbles do
		if not states[seat] or not bySlot[seat] then
			destroyBubble(bub.b)
			bubbles[seat] = nil
		end
	end
	for seat, st in states do
		local spot = bySlot[seat]
		if spot and spot.holder.AbsoluteSize.X > 0 then
			local bub = bubbles[seat]
			if bub and bub.holder ~= spot.holder then
				destroyBubble(bub.b)
				bub = nil
			end
			if not bub then
				bub = { b = makeBubble(spot.holder, false), holder = spot.holder }
				bubbles[seat] = bub
			end
			local alpha = st.mode == "f" and fadeOf(now - st.t, LINGER) or 1
			paint(bub.b, st.text, spot.color or colorOf(seat), spot.U, st.mode == "o", alpha)
			local size = spot.holder.AbsoluteSize
			place(bub.b, spot.x * spot.scale, spot.y * spot.scale, size.X, size.Y, spot.U)
		end
	end
end

local function clearAll()
	closeMine()
	for seat, bub in bubbles do
		destroyBubble(bub.b)
	end
	bubbles = {}
	states = {}
end

local warned = false
local function step(dt)
	local ok, err = pcall(function()
		local now = os.clock()
		if not inRoom() then
			if mine and mine.mode ~= "note" then
				send("x")
				closeMine()
			end
			if next(states) ~= nil or next(bubbles) ~= nil then
				for _, bub in bubbles do
					destroyBubble(bub.b)
				end
				bubbles, states = {}, {}
			end
		end
		if mine then
			stepMine(now)
		end
		stepOthers(now)
	end)
	if not ok and not warned then
		warned = true
		warn("[TTO] cursor chat error: " .. tostring(err))
	end
end

------------------------------------------------------------ ENTER

local function enterPressed(input, processed)
	if processed or input.KeyCode ~= Enum.KeyCode.Return then
		return
	end
	if mine and mine.mode == "typing" then
		return
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) or UserInputService:IsKeyDown(Enum.KeyCode.RightAlt) then
		return -- ALT+ENTER is fullscreen
	end
	local X = g.UI and g.UI.X
	if X and ((X.typing and X.typing()) or X.keysOff) then
		return
	end
	if (g.Shop and g.Shop.isOpen) or g.builderCover then
		return
	end
	if g.Party and g.Party.prompting and g.Party.prompting() then
		return -- ENTER accepts the invite / join request that is waiting
	end
	if not inRoom() then
		showNote("ONLINE ONLY: HOST OR JOIN A GAME")
		return
	end
	openBox()
end

function t.init(p)
	g = p
	local PlayerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	gui = Instance.new("ScreenGui")
	gui.Name = "TTOCursorChat"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 150
	gui.Parent = PlayerGui
	UserInputService.InputBegan:Connect(function(input, processed)
		local ok, err = pcall(enterPressed, input, processed)
		if not ok then
			warn("[TTO] cursor chat key error: " .. tostring(err))
		end
	end)
	RunService.RenderStepped:Connect(step)
	task.spawn(function()
		local net = ReplicatedStorage:WaitForChild("TTONet", 30)
		if net then
			net.OnClientEvent:Connect(function(kind, a, b)
				if kind == "cc" then
					pcall(onChat, a, b)
				end
			end)
		end
	end)
end

t.clear = clearAll

return t




