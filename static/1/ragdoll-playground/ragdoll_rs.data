function t.cut(p263, p264: number, p265: number, p266: number, p267: number, p268: number, p269: number, p270: number?)
	
	local v_u_271 = p266 - p264
	local v_u_272 = p267 - p265
	local v273 = max(1, (sqrt(v_u_271 * v_u_271 + v_u_272 * v_u_272)))
	local v_u_274 = -v_u_272 / v273
	local v_u_275 = v_u_271 / v273
	local v276 = p270 or rgb(150, 8, 22)
	local v277 = max(1, (floor(max(abs(v_u_271), (abs(v_u_272))) + 0.5)))
	local t9 = { life = 0, d = 0, life = p268 }
	local t10 = {}
	local v_u_278 = v276
	local v_u_279 = v277
	local v_u_280 = p264
	local v_u_281 = p265
	local v_u_282 = p269
	function t9.d(p283, p284)
		
		if t10[0] then
			return
		end
		if not (p283.t < 0) then
			local v285 = p283.t / p283.life
			local v286 = min(1, v285 / 0.22)
			local v287 = 1 - clamp((v285 - 0.22) / 0.45, 0, 1)
			local v288 = 1 - clamp((v285 - 0.55) / 0.45, 0, 1)
			local v289 = mix(v_u_278, v_u_2, v287)
			local v290 = rgb(8, 0, 4)
			local v291 = max(1, (floor(v_u_279 * v286)))
			for v292 = 0, v291 do
				local v293 = v292 / v291
				local v294: number = v_u_280 + v_u_271 * v286 * v293
				local v295: number = v_u_281 + v_u_272 * v286 * v293
				local v296 = sin(v293 * v286 * 3.141592653589793)
				if v296 > 0.2 then
					local v297 = floor(v_u_282 * v296 * v287 + 0.5) + 1
					blend(p284, v294 + v_u_274 * v297, v295 + v_u_275 * v297, v290, v288 * 0.85)
					blend(p284, v294 - v_u_274 * v297, v295 - v_u_275 * v297, v290, v288 * 0.85)
					if v_u_282 > 1 and v296 > 0.5 then
						blend(p284, v294 + v_u_274, v295 + v_u_275, v289, v288 * v287)
						blend(p284, v294 - v_u_274, v295 - v_u_275, v289, v288 * v287)
					end
				end
				blend(p284, v294, v295, v289, v288 * (v296 * 0.5 + 0.5))
			end
		end
	end
	return p263(t9)
end
local function lumLut(p298)
	
	local v299 = table.create(256, 0)
	for v300 = 0, 255 do
		local v301, v302, v303 = p298(v300)
		v299[v300 + 1] = rgb(clamp(v301, 0, 255), clamp(v302, 0, 255), (clamp(v303, 0, 255)))
