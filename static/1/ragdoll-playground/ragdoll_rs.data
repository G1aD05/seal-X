			local id = v50.id
			if not v_u_2.Passes.ownsItem(id) then
				local v51
				if Passes.CAT[v50.id] == "powers" then
					v51 = t12 or t11
				else
					v51 = t11
				end
				local id2 = v50.id
				table.insert(v51, id2)
			end
		end
	end
	for v52, v53 in v_u_2.Body and v_u_2.Body.SKINS or {} do
		for _2, v54 in v53 do
			if v54.vip and (v54.id == "rainbow" and not Passes.ownsSkin(v52, v54.id)) then
				local v55 = v52 .. "/" .. v54.id
				table.insert(t13, v55)
			end
		end
	end
	table.sort(t12)
	table.sort(t11)
	table.sort(t13)
	return t12, t11, t13
end
