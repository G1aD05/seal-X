local t = {}
t.EverythingPrice = 599
t.EverythingPlusPrice = 999
t.SinglePrice = 99
t.OldPowersWorth = 459
t.UpgradeAdd = 50
t.CreditCap = 349
t.EverythingFloor = 349
t.PlusFloor = 849
function t.down49(p1: number)
	
	local v2 = (p1 + 1) / 50
	local v3 = math.floor(v2) * 50 - 1
	return v3 < 49 and 0 or v3
end
function t.half(p4: number)
	
	local v5 = p4 / 2
	return (math.floor(v5))
end
function t.steps(p6: number, p7: number)
	
	local v8 = t.down49(p7)
	local v9 = t.down49(p6 - 1)
	local t2 = {}
	while v8 <= v9 and v9 > 0 do
		table.insert(t2, v9)
		v9 = v9 - 50
	end
	return t2
end
function t.plusFromEverything()
	
	return t.down49(t.EverythingPlusPrice - t.EverythingPrice + t.UpgradeAdd)
end
function t.withCredit(p10: number, p11: number, p12: number)
	
	if p12 <= 0 then
		return p10
	end
	local CreditCap = t.CreditCap
	local v13 = p10 - math.min(p12, CreditCap)
	return (math.max(v13, p11))
end
function t.packPrice(p14: number, p15: number)
	
	if p15 <= 0 then
		return p14
	end
	local v16 = p15 * t.half(t.SinglePrice)
	local half = t.half
	return p14 - math.min(v16, half(p14))
end
function t.charge(p17: number, p18: number, p19: number, p20: number)
	
	local v21
	if p17 <= p18 and p17 then
		v21 = p17
	else
		local down49 = t.down49
		v21 = math.min(p17, down49(p18))
	end
	if p19 <= 0 then
		return v21, v21
	end
	if v21 <= p19 then
		return 0, v21
	end
	local v22 = t.down49(p18 - p19)
	local down492 = t.down49
	local v23 = math.max(v22, down492(p20))
	if p17 <= v23 then
		v23 = p17 or v23
	end
	return v23, v21
end
return t



