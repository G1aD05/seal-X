		local v42 = math.sin(v40)
		for v43 = 0, 7, 0.5 do
			local v44 = v41 * v43 + 7.5
			local v45 = v42 * v43 + 7.5
			local v46 = v44 + v42
			local v47 = v45 - v41
			local B = t2.B
			local v48 = v_u_31(v46 + 0.5)
			local v49 = v_u_31(v47 + 0.5)
			if v48 >= 0 and (v48 < 16 and (v49 >= 0 and (v49 < 16 and (not v32[v49 * 16 + v48 + 1] or B ~= t2.B)))) then
				v32[v49 * 16 + v48 + 1] = B
			end
			local v50 = v44 - v42
			local v51 = v45 + v41
			local B2 = t2.B
			local v52 = v_u_31(v50 + 0.5)
			local v53 = v_u_31(v51 + 0.5)
			if v52 >= 0 and (v52 < 16 and (v53 >= 0 and (v53 < 16 and (not v32[v53 * 16 + v52 + 1] or B2 ~= t2.B)))) then
				v32[v53 * 16 + v52 + 1] = B2
			end
		end
		for v54 = 0, 7, 0.5 do
			local v55 = v41 * v54 + 7.5
			local v56 = v42 * v54 + 7.5
			local v57 = v54 < 2 and t2.w or t2.c
			local v58 = v_u_31(v55 + 0.5)
			local v59 = v_u_31(v56 + 0.5)
			if v58 >= 0 and (v58 < 16 and (v59 >= 0 and (v59 < 16 and (not v32[v59 * 16 + v58 + 1] or v57 ~= t2.B)))) then
				v32[v59 * 16 + v58 + 1] = v57
