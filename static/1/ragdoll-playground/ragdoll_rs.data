local v_u_304 = H
local v_u_305 = readu32
local function lutFrame(p306: buffer, p307: {[any]: any})
	
	for v308 = 0, W * v_u_304 * 4 - 4, 4 do
		local v309 = v_u_305(p306, v308)
		writeu32(p306, v308, p307[rshift(band(v309, 255) * 77 + band(rshift(v309, 8), 255) * 151 + band(rshift(v309, 16), 255) * 28, 8) + 1])
