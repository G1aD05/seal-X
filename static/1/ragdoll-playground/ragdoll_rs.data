	for v379 = 1, p372 do
		local t21 = {
			a = 0,
			l = 0,
			a = v379 <= p372 * 0.4 and atan2(p376, p375) + (random() - 0.5) * 1.1 or random() * 3.141592653589793 * 2,
			l = p373 * (0.45 + random() * 0.55)
		}
		table.insert(t20, t21)
	end
	local v_u_380, v_u_381, v_u_382 = v_u_368.unpack(p378)
	local t22 = {}
	local v_u_383 = t20
	local v_u_384 = p370
	local v_u_385 = p371
