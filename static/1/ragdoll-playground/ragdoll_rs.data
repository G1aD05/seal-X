return t-- GLUE tool: sticks two pieces (body parts or props) together.
--
-- A piece is a capsule between two physics particles (pa, pb). Gluing two pieces adds distance constraints
-- between their particles at the distances they have right now, so the pair keeps its relative pose:
--   STRONG    stiff constraints (a rigid weld)
--   STRETCHY  very soft constraints (a rubbery joint that wobbles and stretches)
-- If the glue is pulled far past its resting shape it lets go ("snaps"). Click a glue spot to peel it off.
local Config = require(script.Parent.Config)
local rgb = Config.rgb
local mix = Config.mix
local readu32 = buffer.readu32
local writeu32 = buffer.writeu32
local floor = math.floor
local sqrt = math.sqrt
local abs = math.abs

local t = {}
t.NAME = "Glue"
t.list = {}
t.MAX = 80

-- stiff: constraint stiffness (1 = rigid); snap: how many pixels a link may be stretched or squeezed before it lets go
t.MODES = {
	{ name = "STRONG", stiff = 1, snap = 24 },
	{ name = "STRETCHY", stiff = 0.05, snap = 60 },
}

local G, Body, Phys, Sfx

function t.init(game)
	G = game
	Body = game.Body
	Phys = game.Phys
	Sfx = game.Sfx
end

local function snd(name: string, vol: number, pitch: number)
	if Sfx and Sfx.play then
		Sfx.play(name, vol, pitch)
	end
end

local function flash(text: string)
	local UI = G and G.UI
	if UI and UI.flashHint then
		UI.flashHint(text, Color3.fromRGB(255, 196, 120))
	end
end

-- a glue is still holding if both pieces are alive and still own the particles the links were made on
local function valid(g): boolean
	local a, b = g.a, g.b
	return a.alive == true and b.alive == true and a.pa == g.apa and a.pb == g.apb and b.pa == g.bpa and b.pb == g.bpb
end

local function dropLinks(g)
	for _, link in g.cs do
		-- only kill a constraint that still is ours (ids are reused after a kill or a physics reset)
		if Phys.calive[link.c] == 1 and Phys.ca[link.c] == link.p and Phys.cb[link.c] == link.q then
			Phys.killC(link.c)
		end
	end
	table.clear(g.cs)
	g.dead = true
end

local function remove(g)
	dropLinks(g)
	local i = table.find(t.list, g)
	if i then
		table.remove(t.list, i)
	end
end

-- Where is a glue spot right now? (the spot on piece A, then the spot on piece B)
local function spots(g)
	local ax, ay = Body.worldOf(g.a, g.au, g.av)
	local bx, by = Body.worldOf(g.b, g.bu, g.bv)
	return ax, ay, bx, by
end

-- Glue the piece under (x1,y1) to the piece under (x2,y2). Returns the glue, or nil and a reason:
-- "NEEDS" (an end isn't on a piece), "SAME" (both ends on one piece), "ALREADY" (these two are already glued)
function t.create(x1: number, y1: number, x2: number, y2: number, mode: number?)
	if not Body then
		return nil, "NEEDS"
	end
	local a = Body.pieceNear(x1, y1, 4)
	local b = Body.pieceNear(x2, y2, 4)
	if not (a and b and a.alive and b.alive and a.pa and a.pb and b.pa and b.pb) then
		return nil, "NEEDS"
	end
	if a == b then
		return nil, "SAME"
	end
	for _, g in t.list do
		if (g.a == a and g.b == b) or (g.a == b and g.b == a) then
			return nil, "ALREADY"
		end
	end
	while #t.list >= t.MAX do
		remove(t.list[1])
	end

	local m = t.MODES[mode or 1] or t.MODES[1]
	local g = {
		a = a,
		b = b,
		apa = a.pa,
		apb = a.pb,
		bpa = b.pa,
		bpb = b.pb,
		mode = t.MODES[mode or 1] and (mode or 1) or 1,
		snap = m.snap,
		cs = {},
		dead = false,
		age = 0,
	}
	g.au, g.av = Body.localOf(a, x1, y1)
	g.bu, g.bv = Body.localOf(b, x2, y2)

	-- every particle of one piece to every particle of the other: together with the two pieces' own bones
	-- this fixes their relative position and angle (pieces that share a joint particle skip the zero-length link)
	for _, pair in { { a.pa, b.pa }, { a.pa, b.pb }, { a.pb, b.pa }, { a.pb, b.pb } } do
		local p, q = pair[1], pair[2]
		if p ~= q then
			local c = Phys.newC(p, q, nil, m.stiff)
			if c then
				table.insert(g.cs, { c = c, p = p, q = q })
			end
		end
	end
	if #g.cs == 0 then
		return nil, "SAME"
	end
	table.insert(t.list, g)
	return g
end

-- the glue whose spot is within 5px of (x,y), if any
function t.near(x: number, y: number)
	local best, bestD = nil, 25
	for _, g in t.list do
		if not g.dead and valid(g) then
			local ax, ay, bx, by = spots(g)
			local d = math.min((ax - x) ^ 2 + (ay - y) ^ 2, (bx - x) ^ 2 + (by - y) ^ 2)
			if d <= bestD then
				best, bestD = g, d
			end
		end
	end
	return best
end

-- Click with the glue tool: peel off the glue under the cursor. Returns true if there was one.
function t.peel(x: number, y: number): boolean
	local g = t.near(x, y)
	if not g then
		return false
	end
	remove(g)
	snd("click", 0.4, 1.6)
	return true
end

-- Drag with the glue tool from (x1,y1) to (x2,y2). A short drag is a click: peel glue off.
function t.use(x1: number, y1: number, x2: number, y2: number, mode: number?)
	local dx, dy = x2 - x1, y2 - y1
	if dx * dx + dy * dy <= 16 then
		if not t.peel(x2, y2) then
			flash("DRAG FROM ONE PART TO ANOTHER TO GLUE THEM")
		end
		return
	end
	local g, why = t.create(x1, y1, x2, y2, mode)
	if not g then
		if why == "SAME" then
			flash("THAT'S ONE PART. DRAG TO A DIFFERENT ONE")
		elseif why == "ALREADY" then
			flash("THOSE TWO ARE ALREADY GLUED")
		else
			flash("DRAG FROM ONE PART OR OBJECT TO ANOTHER")
		end
		return
	end
	snd("grab", 0.45, g.mode == 2 and 1.2 or 0.8)
	local Arsenal = G and G.Arsenal
	if Arsenal and Arsenal.remember then
		Arsenal.remember(function()
			if g.dead then
				return false
			end
			remove(g)
			return true
		end, "GLUE")
	end
	return g
end

-- runs every sim tick (after physics): drops glue whose pieces are gone, and snaps overstretched glue
function t.update(dt: number)
	for i = #t.list, 1, -1 do
		local g = t.list[i]
		if g.dead then
			table.remove(t.list, i)
		elseif not valid(g) then
			dropLinks(g)
			table.remove(t.list, i)
		else
			g.age = g.age + dt
			local snapped = false
			for _, link in g.cs do
				local c = link.c
				if Phys.calive[c] ~= 1 or Phys.ca[c] ~= link.p or Phys.cb[c] ~= link.q then
					snapped = true -- something else killed a link: let go of the rest too
					break
				end
				if abs(Phys.clen(c) - Phys.crest[c]) > g.snap then
					snapped = true
					break
				end
			end
			if snapped then
				dropLinks(g)
				table.remove(t.list, i)
				snd("click", 0.5, 0.6)
			end
		end
	end
end

function t.clear()
	for _, g in t.list do
		dropLinks(g)
	end
	table.clear(t.list)
end

function t.count(): number
	return #t.list
end

----------------------------------------------------------------- drawing

local SPOT = {
	{ ".kk.", "kywk", "kyYk", ".kk." }, -- STRONG
	{ ".kk.", "kgwk", "kgGk", ".kk." }, -- STRETCHY
}
local COL = {
	k = rgb(54, 44, 26),
	y = rgb(255, 224, 110),
	Y = rgb(204, 150, 48),
	g = rgb(150, 236, 172),
	G = rgb(60, 156, 96),
	w = rgb(255, 252, 226),
}
local STRAND = { rgb(255, 224, 110), rgb(150, 236, 172) }

local function plot(buf: buffer, x: number, y: number, col: number, alpha: number)
	local W, H = Config.W, Config.H
	x, y = floor(x), floor(y)
	if x >= 0 and y >= 0 and x < W and y < H then
		local off = (x + y * W) * 4
		writeu32(buf, off, alpha >= 1 and col or mix(readu32(buf, off), col, alpha))
	end
end

local function drawSpot(buf: buffer, cx: number, cy: number, mode: number, alpha: number)
	local rows = SPOT[mode] or SPOT[1]
	local x0, y0 = floor(cx) - 1, floor(cy) - 1
	for r = 1, 4 do
		local row = rows[r]
		for c = 1, 4 do
			local ch = string.sub(row, c, c)
			if ch ~= "." then
				plot(buf, x0 + c - 1, y0 + r - 1, COL[ch], alpha)
			end
		end
	end
end

local function drawStrand(buf: buffer, x1: number, y1: number, x2: number, y2: number, mode: number)
	local dx, dy = x2 - x1, y2 - y1
	local len = sqrt(dx * dx + dy * dy)
	if len < 5 then
		return
	end
	local n = floor(len)
	for i = 1, n - 1 do
		plot(buf, x1 + dx * i / n, y1 + dy * i / n, STRAND[mode] or STRAND[1], 0.5)
	end
end

function t.draw(buf: buffer)
	for _, g in t.list do
		if not g.dead and valid(g) then
			local ax, ay, bx, by = spots(g)
			drawStrand(buf, ax, ay, bx, by, g.mode)
			drawSpot(buf, ax, ay, g.mode, 1)
			drawSpot(buf, bx, by, g.mode, 1)
		end
	end
end

-- cursor help for the tool: ring a glue spot you could peel, or preview a blob on a part you could glue
function t.ghost(buf: buffer, x: number, y: number, mode: number?)
	if not Body then
		return
	end
	local g = t.near(x, y)
	if g then
		local ax, ay, bx, by = spots(g)
		local cx, cy = ax, ay
		if (bx - x) ^ 2 + (by - y) ^ 2 < (ax - x) ^ 2 + (ay - y) ^ 2 then
			cx, cy = bx, by
		end
		cx, cy = floor(cx), floor(cy)
		local white = rgb(255, 255, 255)
		for i = -3, 4 do
			plot(buf, cx + i, cy - 4, white, 0.7)
			plot(buf, cx + i, cy + 5, white, 0.7)
			plot(buf, cx - 4, cy + i, white, 0.7)
			plot(buf, cx + 5, cy + i, white, 0.7)
		end
		return
	end
	local piece = Body.pieceNear(x, y, 4)
	if piece and piece.alive and piece.pa and piece.pb then
		drawSpot(buf, x, y, mode or 1, 0.55)
	end
end

return t




local Config, W, H, readu8, writeu8, readu32, writeu32, floor, sqrt, abs, max, min, random, rgb, mix, v2, t, v_u_3, v_u_4, v_u_5, v_u_6, v_u_7, v_u_8, t2, v9, v12, v13, v14, v15, v16, v17
do
