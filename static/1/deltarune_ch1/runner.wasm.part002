  (data (i32.const 1537040) "precision mediump float;\09\09\09\09\09\09\0a#define HIGHPREC \0a#define LOWPREC lowp                           \0a")
  (data (i32.const 1537152) "uniform sampler2D gm_BaseTexture;              \0a\0auniform bool gm_PS_FogEnabled;\09\09\09\09\09\0auniform LOWPREC vec4 gm_FogColour;             \0auniform bool gm_AlphaTestEnabled;\09\09\09\09\0auniform LOWPREC float gm_AlphaRefValue;\09\09\0a\0avoid DoAlphaTest(LOWPREC vec4 SrcColour)\09\09\0a{\09\09\09\09\09\09\09\09\09\09\09\09\0a#ifdef USE_ALPHATEST\09\09\09\09\09\09\09\0a\09{\09\09\09\09\09\09\09\09\09\09\09\0a\09\09if (SrcColour.a <= gm_AlphaRefValue)\09\0a\09\09{\09\09\09\09\09\09\09\09\09\09\0a\09\09\09discard;\09\09\09\09\09\09\09\0a\09\09}\09\09\09\09\09\09\09\09\09\09\0a\09}\09\09\09\09\09\09\09\09\09\09\09\0a#endif // USE_ALPHATEST\09\09\09\09\09\09\0a}\09\09\09\09\09\09\09\09\09\09\09\09\0a\0aLOWPREC vec4 DoFog(LOWPREC vec4 SrcColour, float fogval) \0a{\09\09\09\09\09\09\09\09\09\09\09\09\0a\09vec4 retCol;\09\09\09\09\09\09\09\09\0a#ifdef USE_FOG\09\09\09\09\09\09\09\09\09\0a\09{\09\09\09\09\09\09\09\09\09\09\09\0a\09\09retCol.rgb = mix(SrcColour.rgb, gm_FogColour.rgb, clamp(fogval, 0.0, 1.0)); \0a\09\09retCol.a = SrcColour.a;\09\09\09\09\09\0a\09}\09\09\09\09\09\09\09\09\09\09\09\0a#else\09// USE_FOG\09\09\09\09\09\09\09\09\0a\09retCol = SrcColour;\09\09\09\09\09\09\09\0a#endif\09// USE_FOG\09\09\09\09\09\09\09\09\0a\09return retCol;\09\09\09\09\09\09\09\09\0a}\09\09\09\09\09\09\09\09\09\09\09\09\0a\0a")
  (data (i32.const 1538000) "varying HIGHPREC vec2 v_vTexcoord;\09\09\09\09\09\09\09\09\09\09\0avarying LOWPREC vec4 v_vColour;\09\09\09\09\09\09\09\09\09\09\0avarying float v_fFog;\09\09\09\09\09\09\09\09\09\09\09\0a\0avoid main()\09\09\09\09\09\09\09\09\09\09\09\09\09\0a{\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a\09LOWPREC vec4 vertColour = v_vColour;\09\09\09\09\09\09\09\09\0a\09LOWPREC vec4 texelColour = texture2D( gm_BaseTexture, v_vTexcoord );\09\0a\09LOWPREC vec4 combinedColour = vertColour * texelColour;\09\09\09\09\0a\0a\09DoAlphaTest(combinedColour);\09\09\09\09\09\09\09\09\0a\09combinedColour = DoFog(combinedColour, v_fFog);\09\09\09\09\09\09\09\09\0a\0a\09gl_FragColor = combinedColour;\09\09\09\09\09\09\09\09\0a}\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a")
  (data (i32.const 1538512) "varying HIGHPREC vec2 v_vTexcoord;\09\09\09\09\09\09\09\09\09\09\0avarying LOWPREC vec4 v_vColour;\09\09\09\09\09\09\09\09\09\09\0avarying float v_fFog;\09\09\09\09\09\09\09\09\09\09\09\0a\0avoid main()\09\09\09\09\09\09\09\09\09\09\09\09\09\0a{\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a\09LOWPREC vec4 vertColour = v_vColour;\09\09\09\09\09\09\09\09\0a\09LOWPREC vec4 texelColour = texture2D( gm_BaseTexture, v_vTexcoord );\09\0a\09LOWPREC vec4 combinedColour = vertColour * texelColour;\09\09\09\09\0a\0a\09DoAlphaTest(combinedColour);\09\09\09\09\09\09\09\09\0a\09combinedColour = DoFog(combinedColour, v_fFog);\09\09\09\09\09\09\09\09\0a\0a\09gl_FragColor = combinedColour;\09\09\09\09\09\09\09\09\0a}\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a")
  (data (i32.const 1539024) "varying HIGHPREC vec2 v_vTexcoord;\09\09\09\09\09\09\09\09\09\09\0avarying LOWPREC vec4 v_vColour;\09\09\09\09\09\09\09\09\09\09\0avarying float v_fFog;\09\09\09\09\09\09\09\09\09\09\09\0a\0avoid main()\09\09\09\09\09\09\09\09\09\09\09\09\09\0a{\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a\09LOWPREC vec4 vertColour = v_vColour;\09\09\09\09\09\09\09\09\0a\09LOWPREC vec4 texelColour = texture2D( gm_BaseTexture, v_vTexcoord );\09\0a\09LOWPREC vec4 combinedColour = vertColour * texelColour;\09\09\09\09\0a\0a\09DoAlphaTest(combinedColour);\09\09\09\09\09\09\09\09\0a\09combinedColour = DoFog(combinedColour, v_fFog);\09\09\09\09\09\09\09\09\0a\0a\09gl_FragColor = combinedColour;\09\09\09\09\09\09\09\09\0a}\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a")
  (data (i32.const 1539536) "varying LOWPREC vec4 v_vColour;\09\09\09\09\09\09\09\09\09\09\0avarying float v_fFog;\09\09\09\09\09\09\09\09\09\09\09\0a\0avoid main()\09\09\09\09\09\09\09\09\09\09\09\09\09\0a{\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a\09LOWPREC vec4 combinedColour = v_vColour;\09\09\09\09\09\09\09\0a\0a\09DoAlphaTest(combinedColour);\09\09\09\09\09\09\09\09\0a\09combinedColour = DoFog(combinedColour, v_fFog);\09\09\09\09\09\09\09\09\0a\0a\09gl_FragColor = combinedColour;\09\09\09\09\09\09\09\09\0a}\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a")
  (data (i32.const 1539872) "#define LOWPREC lowp\0a")
  (data (i32.const 1539904) "#define MATRIX_VIEW                    0                               \0a#define MATRIX_PROJECTION              1                               \0a#define MATRIX_WORLD                   2                               \0a#define MATRIX_WORLD_VIEW              3                               \0a#define MATRIX_WORLD_VIEW_PROJECTION   4                               \0a#define MATRICES_MAX                   5                               \0a\0auniform mat4 gm_Matrices[MATRICES_MAX];\09\09\09\09\09\09\09\09\0a\0auniform bool gm_LightingEnabled;\09\09\09\09\09\09\09\09\09\09\0auniform bool gm_VS_FogEnabled;\09\09\09\09\09\09\09\09\09\09\09\0auniform float gm_FogStart;\09\09\09\09\09\09\09\09\09\09\09\09\0auniform float gm_RcpFogRange;\09\09\09\09\09\09\09\09\09\09\09\0a\0a#ifndef MAX_VS_LIGHTS                                                  \0a#define MAX_VS_LIGHTS\098\09\09\09\09\09\09\09\09\09\09\09\09\0a#endif                                                                 \0a#define MIRROR_WIN32_LIGHTING_EQUATION\09\09\09\09\09\09\09\09\09\0a\0astruct LightEnv\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a{\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a\09vec4 ambientcol;\09\09\09\09\09\09\09\09\09\09\09\09\09\0a\09vec4 m_dirLights_dir[MAX_VS_LIGHTS];\09\09\09\09\09\09\09\09\0a\09vec4 m_dirLights_diffusecol[MAX_VS_LIGHTS];\09\09\09\09\09\09\09\0a\09vec4 m_pointLights_posrange[MAX_VS_LIGHTS];\09\09\09\09\09\09\09\0a\09vec4 m_pointLights_diffusecol[MAX_VS_LIGHTS];\09\09\09\09\09\09\0a};\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a\0auniform LightEnv u_LightEnv;\09\09\09\09\09\09\09\09\09\09\09\0a\0afloat CalcFogFactor(vec4 pos)\09\09\09\09\09\09\09\09\09\09\09\0a{\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a#ifdef USE_FOG\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a\09{\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a\09\09vec4 viewpos = gm_Matrices[MATRIX_WORLD_VIEW] * pos;\09\09\09\09\09\09\09\0a\09\09float fogfactor = ((viewpos.z - gm_FogStart) * gm_RcpFogRange);\09\0a\09\09return fogfactor;\09\09\09\09\09\09\09\09\09\09\09\09\0a\09}\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a#else // USE_FOG\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a\09{\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a\09\09return 0.0;\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a\09}\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a#endif\09// USE_FOG\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a}\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a\0avec4 DoDirLight(vec3 ws_normal, vec4 dir, vec4 diffusecol)\09\09\09\09\0a{\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a\09float dotresult = dot(ws_normal, dir.xyz);\09\09\09\09\09\09\09\0a\09dotresult = max(0.0, dotresult);\09\09\09\09\09\09\09\09\09\0a\0a\09return dotresult * diffusecol;\09\09\09\09\09\09\09\09\09\09\0a}\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a\0avec4 DoPointLight(vec3 ws_pos, vec3 ws_normal, vec4 posrange, vec4 diffusecol)\09\09\0a{\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a\09vec3 diffvec = ws_pos - posrange.xyz;\09\09\09\09\09\09\09\09\0a\09float veclen = length(diffvec);\09\09\09\09\09\09\09\09\09\09\0a\09diffvec /= veclen;\09// normalise\09\09\09\09\09\09\09\09\09\0a#ifdef MIRROR_WIN32_LIGHTING_EQUATION\09\09\09\09\09\09\09\09\09\0a\09// This is based on the Win32 D3D and OpenGL falloff model, where:\09\0a\09// Attenuation = 1.0f / (factor0 + (d * factor1) + (d*d * factor2))\09\0a\09// For some reason, factor0 is set to 0.0f while factor1 is set to 1.0f/lightrange (on both D3D and OpenGL)\09\0a\09// This'll result in no visible falloff as 1.0f / (d / lightrange) will always be larger than 1.0f (if the vertex is within range) \0a\09float atten = veclen < posrange.w ? 1.0 : 0.0;\09\09\09\09\09\09\0a#else\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a\09float atten = clamp( (1.0 - (veclen / posrange.w)), 0.0, 1.0);\09\09\0a#endif\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a\09float dotresult = dot(ws_normal, diffvec);\09\09\09\09\09\09\09\0a\09dotresult = max(0.0, dotresult);\09\09\09\09\09\09\09\09\09\0a\0a\09return dotresult * atten * diffusecol;\09\09\09\09\09\09\09\09\0a}\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a\0avec4 DoLighting(vec4 vertexcolour, vec4 objectspacepos, vec3 objectspacenormal) \0a{\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a\09{\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a\09\09// Normally we'd have the light positions\5cdirections back-transformed from world to object space \0a\09\09// But to keep things simple for the moment we'll just transform the normal to world space \0a       // Also, depending on what world transforms have been set, the sphere of the light radius   \0a       // may become a non-axis aligned irregularly scaled and sheared ellipsoid in object space \0a       // which is obviously much harder to test against               \0a\09\09vec4 objectspacenormal4 = vec4(objectspacenormal, 0.0);\09\09\09\0a\09\09vec3 ws_normal;\09\09\09\09\09\09\09\09\09\09\09\09\09\0a\09\09ws_normal = (gm_Matrices[MATRIX_WORLD] * objectspacenormal4).xyz;\09\09\09\09\0a\09\09ws_normal = -normalize(ws_normal);\09\09\09\09\09\09\09\09\0a\0a\09\09vec3 ws_pos;\09\09\09\09\09\09\09\09\09\09\09\09\09\0a\09\09ws_pos = (gm_Matrices[MATRIX_WORLD] * objectspacepos).xyz;\09\09\09\09\09\0a\0a\09\09// Accumulate lighting from different light types\09\09\09\09\0a\09\09vec4 accumcol = vec4(0.0, 0.0, 0.0, 0.0);\09\09\09\09\09\09\0a\09\09for(int i = 0; i < MAX_VS_LIGHTS; i++)\09\09\09\09\09\09\09\09\0a\09\09{\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a\09\09\09accumcol += DoDirLight(ws_normal, u_LightEnv.m_dirLights_dir[i], u_LightEnv.m_dirLights_diffusecol[i]); \0a\09\09}\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a\0a\09\09for(int i = 0; i < MAX_VS_LIGHTS; i++)\09\09\09\09\09\09\09\09\0a\09\09{\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a\09\09\09accumcol += DoPointLight(ws_pos, ws_normal, u_LightEnv.m_pointLights_posrange[i], u_LightEnv.m_pointLights_diffusecol[i]); \0a\09\09}\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a\0a\09\09accumcol *= vertexcolour;\09\09\09\09\09\09\09\09\09\09\0a\09\09accumcol += u_LightEnv.ambientcol;\09\09\09\09\09\09\09\09\0a\09\09accumcol = min(vec4(1.0, 1.0, 1.0, 1.0), accumcol);\09\09\09\09\0a\09\09accumcol.a = vertexcolour.a;\09\09\09\09\09\09\09\09\09\0a\09\09return accumcol;\09\09\09\09\09\09\09\09\09\09\09\09\0a\09}\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a}\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\09\0a")
