--- a/public/style.css
+++ b/public/style.css
@@ -2058,3 +2058,12 @@ label.check, .overseer-check {
 .chat-edit-box { width: 100%; padding: 4px 8px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.25); color: inherit; }
