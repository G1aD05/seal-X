diff --git a/public/style.css b/public/style.css
index b7e52aa..a3afde1 100644
--- a/public/style.css
+++ b/public/style.css
@@ -1765,3 +1765,74 @@ body { -webkit-font-smoothing: antialiased; font-feature-settings: 'cv11', 'ss03
 /* very large Seals balances shouldn't push the nav and the user chip into each other */
 .wallet-chip { max-width: 210px; }
 #wallet-amount { display: inline-block; max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: bottom; }
+
+
+/* ── ADMIN PANEL: tier groups, tabs and search ───────────────── */
+#admin-overlay .modal [hidden] { display: none !important; }
+
+#admin-toolbar {
+  position: sticky; top: -28px; z-index: 5;
+  margin: 0 -28px 18px; padding: 14px 28px 12px;
+  background: var(--surface);
+  border-bottom: 1px solid var(--border);
+}
+.admin-search { position: relative; }
+.admin-search-icon {
+  position: absolute; left: 12px; top: 50%; transform: translateY(-50%);
+  color: var(--text-3); display: flex; pointer-events: none;
+}
+#admin-overlay .modal .admin-search input[type="text"] {
+  width: 100%; padding-left: 36px; padding-right: 34px; margin: 0;
+}
+.admin-search-clear {
+  position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
+  width: 24px; height: 24px; border-radius: 50%; border: none;
+  background: var(--bg-4); color: var(--text-2); cursor: pointer;
+  display: flex; align-items: center; justify-content: center;
+}
+.admin-search-clear:hover { color: var(--text); background: var(--border-2); }
+
+.admin-tabs { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
+.admin-tab {
+  display: inline-flex; align-items: center; gap: 7px;
+  height: 30px; padding: 0 12px;
+  background: transparent; color: var(--text-2);
+  border: 1px solid var(--border); border-radius: 999px;
+  font-family: var(--font-display); font-size: 13px; font-weight: 500;
+  cursor: pointer; transition: background .15s, color .15s, border-color .15s;
+}
+.admin-tab:hover { background: rgba(255,255,255,0.05); color: var(--text); }
+.admin-tab.active { background: rgba(255,255,255,0.10); color: var(--text); border-color: var(--border-2); }
+.admin-tab-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--tier-color, var(--text-3)); }
+.admin-tab-count { font-size: 11px; color: var(--text-3); font-variant-numeric: tabular-nums; }
+.admin-tab.active .admin-tab-count { color: var(--text-2); }
+
+.admin-search-meta { margin-top: 10px; font-size: 12px; color: var(--text-3); }
+
+.admin-group { margin-bottom: 26px; }
+.admin-group-head {
+  display: flex; align-items: center; gap: 9px;
+  margin-bottom: 12px; padding-bottom: 10px;
+  border-bottom: 1px solid var(--border);
+}
+.admin-group-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--tier-color); box-shadow: 0 0 0 3px color-mix(in srgb, var(--tier-color) 22%, transparent); }
+.admin-group-name { font-size: 15px; font-weight: 700; color: var(--text); letter-spacing: -0.01em; }
+.admin-group-sub { font-size: 13px; color: var(--text-3); }
+.admin-group-count { margin-left: auto; font-size: 12px; color: var(--text-3); }
+
+.admin-group-body { display: flex; flex-direction: column; gap: 12px; }
+.admin-section {
+  padding: 16px 18px;
+  background: var(--bg-2);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-md);
+}
+.admin-section > .field-label:first-child { color: var(--text); font-size: 12px; }
+.admin-section > :last-child { margin-bottom: 0; }
+
+.admin-no-results { padding: 28px 12px; text-align: center; font-size: 14px; color: var(--text-3); }
+
+@media (max-width: 560px) {
+  #admin-toolbar { margin: 0 -20px 16px; padding: 12px 20px 10px; top: -20px; }
+  .admin-section { padding: 14px; }
+}
