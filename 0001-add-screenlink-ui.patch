+.sl-log-row { line-height: 1.5; word-break: break-word; }
+.sl-log-row .sl-log-time { color: var(--text-3); margin-right: 6px; }
+.sl-log-row.sl-log-action { color: var(--accent-2); }
+
+.sl-stop-btn { width: 100%; color: var(--danger); border-color: rgba(248,113,113,0.3); }
+.sl-stop-btn:hover { background: rgba(248,113,113,0.1); border-color: var(--danger); }
+
+.sl-list-row { display: flex; align-items: center; gap: 10px; }
+.sl-list-row .sl-list-main { flex: 1; min-width: 0; }
+.sl-list-row .sl-list-sub { color: var(--text-3); font-size: 11px; margin-top: 2px; }
+.granted-user-list button { width: auto; padding: 6px 12px; font-size: 12px; }
