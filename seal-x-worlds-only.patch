+      margin-bottom: 6px;
+    }
+    .mkt-stat .value {
+      font-family: var(--font-display);
+      font-size: 20px; font-weight: 700;
+    }
+
+    .mkt-grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
+      gap: 14px;
+      margin-bottom: 28px;
+    }
+    .mkt-card {
+      background: var(--surface);
+      border: 1px solid var(--border);
+      border-radius: var(--radius-lg);
+      padding: 16px;
+    }
+    .mkt-card-head {
+      display: flex; justify-content: space-between; align-items: flex-start;
+      margin-bottom: 6px;
+    }
+    .mkt-symbol { font-family: var(--font-display); font-size: 17px; font-weight: 800; }
+    .mkt-name { font-size: 12px; color: var(--text-2); }
+    .mkt-price-block { text-align: right; }
+    .mkt-price { font-family: var(--font-mono); font-size: 17px; font-weight: 700; }
+    .mkt-change { font-family: var(--font-mono); font-size: 12px; }
+    .mkt-change.up { color: var(--success); }
+    .mkt-change.down { color: var(--danger); }
+    .mkt-change.flat { color: var(--text-3); }
+
+    .mkt-spark { width: 100%; height: 40px; display: block; margin: 8px 0 12px; }
+    .mkt-spark polyline { fill: none; stroke-width: 1.6; }
+    .mkt-spark.up polyline { stroke: var(--success); }
+    .mkt-spark.down polyline { stroke: var(--danger); }
+    .mkt-spark.flat polyline { stroke: var(--text-3); }
+
+    .mkt-owned {
+      font-family: var(--font-mono); font-size: 12px; color: var(--text-2);
+      margin-bottom: 10px;
+    }
+    .mkt-owned b { color: var(--text); }
+
+    .mkt-trade-row { display: flex; gap: 8px; }
+    .mkt-trade-row input {
+      width: 64px; flex: 0 0 64px;
+      background: var(--bg-3);
+      color: var(--text);
+      border: 1px solid var(--border-2);
+      border-radius: var(--radius-md);
+      padding: 8px 10px;
+      font-family: var(--font-mono);
+      font-size: 13px;
+      outline: none;
+      transition: border-color 0.15s;
+    }
+    .mkt-trade-row input:focus { border-color: var(--accent); }
+    .mkt-trade-row button {
+      flex: 1;
+      background: var(--bg-3);
+      color: var(--text);
+      border: 1px solid var(--border-2);
+      border-radius: var(--radius-md);
+      padding: 8px 10px;
+      font-family: var(--font-mono);
+      font-size: 13px; font-weight: 700;
+      cursor: pointer;
+      transition: background 0.15s, border-color 0.15s;
+    }
+    .mkt-trade-row button.buy:hover { border-color: var(--success); }
+    .mkt-trade-row button.sell:hover { border-color: var(--danger); }
+    .mkt-trade-row button:disabled { opacity: 0.5; cursor: not-allowed; }
+
+    .mkt-card-error {
+      font-size: 12px; color: var(--danger);
+      margin-top: 8px; min-height: 1.4em;
+    }
+
+    .mkt-portfolio-title {
+      font-size: 13px; font-weight: 700; text-transform: uppercase;
+      letter-spacing: 0.08em; color: var(--text-2);
+      margin: 0 0 12px;
+    }
+    .mkt-holding-row {
+      display: flex; justify-content: space-between; align-items: center;
+      background: var(--surface);
+      border: 1px solid var(--border);
+      border-radius: var(--radius-sm);
+      padding: 8px 14px;
+      font-family: var(--font-mono);
+      font-size: 12px; color: var(--text-2);
+      margin-bottom: 6px;
+    }
+    .mkt-holding-row b { color: var(--text); }
+
+    .mkt-note {
+      font-size: 12px; color: var(--text-3);
+      line-height: 1.5;
+      margin-top: 8px;
+    }
+  </style>
+</head>
+<body>
