+
+  <script src="js/api.js"></script>
+  <script src="js/cookieSync.js"></script>
+  <script src="js/icons.js"></script>
+  <script src="js/main.js"></script>
+  <script>
+    var WORLDS = [], CAN_CREATE = false, EDITING = null, ROOM = null, ES = null;
+    var Q = function (id) { return document.getElementById(id); };
+    function el(tag, props, kids) {
+      var n = document.createElement(tag);
+      Object.keys(props || {}).forEach(function (k) { if (k === 'text') n.textContent = props[k]; else if (k === 'on') Object.keys(props.on).forEach(function (e) { n.addEventListener(e, props.on[e]); }); else n.setAttribute(k, props[k]); });
+      (kids || []).forEach(function (c) { n.appendChild(c); });
+      return n;
+    }
+    async function req(path, opts) {
+      var r = await fetch(path, Object.assign({ credentials: 'same-origin', headers: { 'Content-Type': 'application/json' } }, opts || {}));
+      var d = await r.json().catch(function () { return {}; });
+      if (!r.ok) throw new Error(d.error || 'Something went wrong.');
+      return d;
+    }
+
+    // ── Lobby ──────────────────────────────────────────────
+    async function loadLobby() {
+      var d = await req('/api/worlds');
+      WORLDS = d.worlds; CAN_CREATE = d.canCreate;
+      Q('w-admin').classList.toggle('hidden', !CAN_CREATE);
+      var grid = Q('w-grid'); grid.textContent = '';
+      if (!WORLDS.length) grid.appendChild(el('p', { class: 'page-sub', text: 'No worlds yet.' }));
+      WORLDS.forEach(function (w) {
+        var card = el('div', { class: 'game-card', style: 'padding:14px;display:grid;gap:8px;align-content:start' });
+        if (w.thumb) card.appendChild(el('img', { src: w.thumb, alt: '', style: 'width:100%;height:110px;object-fit:cover;border-radius:8px' }));
+        card.appendChild(el('strong', { text: w.name }));
+        card.appendChild(el('span', { class: 'page-sub', text: w.desc || '' }));
+        card.appendChild(el('span', { style: 'font-size:.85em;opacity:.8', text: w.players + ' playing • ' + w.servers + ' server' + (w.servers === 1 ? '' : 's') + ' • up to ' + w.maxPlayers + (w.products.length ? ' • has items' : '') }));
