+  <style>
+    /* ── MARKET (page-specific; everything else comes from style.css) ── */
+    .mkt-summary {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
+      gap: 12px;
+      margin-bottom: 24px;
+    }
