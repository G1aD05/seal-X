+    <div class="modal">
+      <button class="modal-close" onclick="closeAuth()"><i data-icon="x" data-size="16"></i></button>
+      <div class="modal-tabs">
+        <button class="tab-btn active" onclick="switchTab('login')">Sign In</button>
+        <button class="tab-btn" onclick="switchTab('register')">Register</button>
+      </div>
+      <div id="tab-login" class="tab-content active">
+        <h2>Welcome back</h2>
+        <input type="text" id="login-user" placeholder="Username" autocomplete="username">
+        <input type="password" id="login-pass" placeholder="Password" autocomplete="current-password">
+        <p class="auth-error hidden" id="login-error"></p>
+        <button class="btn-primary" onclick="login()">Sign In</button>
+      </div>
+      <div id="tab-register" class="tab-content">
+        <h2>Create account</h2>
+        <input type="text" id="reg-user" placeholder="Username" autocomplete="username">
+        <input type="password" id="reg-pass" placeholder="Password" autocomplete="new-password">
+        <input type="password" id="reg-pass2" placeholder="Confirm password" autocomplete="new-password">
+        <p class="auth-error hidden" id="reg-error"></p>
+        <button class="btn-primary" onclick="register()">Create Account</button>
+      </div>
+    </div>
+  </div>
+
+  <!-- ===================== UPDATE POPUP ===================== -->
+  <div id="popup-overlay" class="modal-overlay hidden">
+    <div class="modal">
+      <button class="modal-close" onclick="dismissPopup()"><i data-icon="x" data-size="16"></i></button>
+      <h2 id="popup-title">Update</h2>
+      <p class="popup-text" id="popup-text"></p>
+    </div>
+  </div>
+
+  <!-- ===================== HEADER ===================== -->
+  <header class="site-header">
+    <div class="header-logo">
+      <a href="/" style="display:flex;align-items:center;gap:10px;text-decoration:none;color:inherit">
+        <span class="logo-mark"><i data-icon="hexagon" data-size="20"></i></span>
+        <span class="logo-text">Seal</span>
+      </a>
+    </div>
+    <div class="header-actions">
+      <div id="user-info" class="user-chip hidden">
+        <span class="user-avatar" id="user-avatar"></span>
+        <span id="user-label"></span>
+        <button class="chip-btn" onclick="logout()">Sign out</button>
+        <button class="chip-btn admin-btn hidden" id="admin-btn" onclick="openAdmin()"><i data-icon="shield" data-size="14"></i> Admin</button>
+      </div>
+      <button class="btn-ghost" id="auth-btn" onclick="openAuth()">Sign In</button>
+      <button class="cloak-btn" id="cloak" title="Cloak window"><i data-icon="eye-off" data-size="14"></i> Cloak</button>
+    </div>
+  </header>
+
+  <!-- ===================== MARKET ===================== -->
+  <main class="page-main">
+    <!-- LOBBY -->
+    <div id="lobby">
+      <div class="page-head">
+        <h1 class="page-title">Worlds</h1>
+        <p class="page-sub">Multiplayer games. Join a server and play with other people — some worlds sell items for Seals.</p>
+      </div>
+      <div id="w-grid" class="game-grid"></div>
+      <details id="w-admin" class="hidden" style="margin-top:22px">
+        <summary id="wf-title" style="cursor:pointer;font-weight:600">Add a world</summary>
+        <div style="display:grid;gap:8px;max-width:560px;margin-top:10px">
+          <input id="wf-name" placeholder="Name" maxlength="60">
+          <input id="wf-url" placeholder="Path to its index.html, e.g. 1/my-world/index.html">
+          <input id="wf-desc" placeholder="Description" maxlength="300">
+          <input id="wf-thumb" placeholder="Thumbnail path (optional)">
+          <input id="wf-max" type="number" min="2" max="50" value="12" placeholder="Max players per server">
+          <textarea id="wf-products" rows="4" placeholder="Products, one per line:&#10;id | Name | price | consumable or permanent | description"></textarea>
+          <div><button class="btn-primary" id="wf-save">Save world</button> <button class="btn-ghost" id="wf-cancel">Cancel edit</button> <span id="wf-msg"></span></div>
+          <p class="page-sub" style="font-size:.85em">Upload the world's folder as a .zip with Admin → Add Game/Tool Files first, then paste its path here. Worlds include <code>/js/seal-world-sdk.js</code> to talk to Seal.</p>
+        </div>
+      </details>
+    </div>
+
+    <!-- ROOM -->
+    <div id="room" class="hidden">
+      <div class="page-head" style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
+        <h1 class="page-title" id="r-title" style="margin:0"></h1>
+        <span class="page-sub" id="r-meta"></span>
+        <button class="btn-ghost" id="r-leave">Leave</button>
+      </div>
+      <div style="display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:14px">
+        <iframe id="r-frame" sandbox="allow-scripts allow-pointer-lock" allow="fullscreen" style="width:100%;height:72vh;border:1px solid rgba(255,255,255,.12);border-radius:12px;background:#000"></iframe>
+        <aside style="display:grid;gap:14px;align-content:start">
+          <div><h3 style="margin:0 0 6px">Players</h3><ul id="r-players" style="list-style:none;margin:0;padding:0"></ul></div>
+          <div id="r-shop-box"><h3 style="margin:0 0 6px">Shop <small id="r-seals" style="opacity:.7"></small></h3><div id="r-products"></div></div>
+        </aside>
+      </div>
+    </div>
+
+    <!-- PURCHASE PROMPT: only this page can show it, so a world can't buy on a player's behalf -->
+    <div id="buy-overlay" class="modal-overlay hidden"><div class="modal">
+      <h2 id="buy-title">Confirm purchase</h2>
+      <p class="popup-text" id="buy-text"></p>
+      <p id="buy-err" style="color:#f77"></p>
+      <div style="display:flex;gap:8px;justify-content:flex-end"><button class="btn-ghost" id="buy-no">Cancel</button><button class="btn-primary" id="buy-yes">Buy</button></div>
+    </div></div>
