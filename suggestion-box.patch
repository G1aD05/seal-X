+    const SG_STATUS_LABEL = { open: 'Open', planned: 'Planned', done: 'Done', declined: 'Declined' };
+    let SUGGESTIONS = [];
+    let SG_FILTER = 'all';
+
+    function sgIsAdmin() { return !!(CURRENT_USER && CURRENT_USER.isAdmin); }
+    function sgSignedIn() { return !!(CURRENT_USER && CURRENT_USER.username); }
+
+    function renderFilters() {
+      const wrap = document.getElementById('sg-filters');
+      wrap.textContent = '';
+      ['all', 'open', 'planned', 'done', 'declined'].forEach(f => {
+        const count = f === 'all' ? SUGGESTIONS.length : SUGGESTIONS.filter(x => x.status === f).length;
+        const b = document.createElement('button');
+        b.className = 'sg-filter' + (SG_FILTER === f ? ' active' : '');
+        b.textContent = (f === 'all' ? 'All' : SG_STATUS_LABEL[f]) + ' (' + count + ')';
+        b.addEventListener('click', () => { SG_FILTER = f; renderFilters(); renderSuggestions(); });
+        wrap.appendChild(b);
+      });
+    }
+
+    function showForm() {
+      const signedIn = sgSignedIn();
+      document.getElementById('sg-form-wrap').classList.toggle('hidden', !signedIn);
+      document.getElementById('sg-signed-out').classList.toggle('hidden', signedIn);
+    }
+
+    function setSgError(msg) {
