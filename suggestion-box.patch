+          const updated = await API.voteSuggestion(sg.id);
+          Object.assign(sg, updated);
+          renderSuggestions();
+        } catch (ex) { alert(ex.message); }
+      });
+
+      const body = document.createElement('div');
+      body.className = 'sg-body';
+
+      const head = document.createElement('div');
+      head.className = 'sg-head';
+      const title = document.createElement('span'); title.className = 'sg-title'; title.textContent = sg.title;
+      const badge = document.createElement('span'); badge.className = 'sg-badge sg-badge-' + sg.status; badge.textContent = SG_STATUS_LABEL[sg.status] || sg.status;
+      head.append(title, badge);
+      body.appendChild(head);
+
+      if (sg.body) {
+        const text = document.createElement('p'); text.className = 'sg-text'; text.textContent = sg.body;
+        body.appendChild(text);
+      }
+
+      const meta = document.createElement('div'); meta.className = 'sg-meta';
+      const by = document.createElement('a'); by.href = 'profile.html?u=' + encodeURIComponent(sg.author); by.textContent = sg.author;
+      meta.append('by ', by, ' \u00B7 ' + timeAgo(sg.createdAt));
+      body.appendChild(meta);
+
+      if (sg.adminNote) {
+        const note = document.createElement('div'); note.className = 'sg-note';
+        note.textContent = 'Staff note: ' + sg.adminNote;
+        body.appendChild(note);
+      }
+
+      const actions = document.createElement('div'); actions.className = 'sg-actions';
+      if (sgIsAdmin()) {
+        const sel = document.createElement('select'); sel.className = 'sg-sort';
+        Object.keys(SG_STATUS_LABEL).forEach(k => {
+          const o = document.createElement('option'); o.value = k; o.textContent = SG_STATUS_LABEL[k]; if (k === sg.status) o.selected = true; sel.appendChild(o);
+        });
+        sel.addEventListener('change', async () => {
+          try { Object.assign(sg, await API.updateSuggestion(sg.id, { status: sel.value })); renderFilters(); renderSuggestions(); }
+          catch (ex) { alert(ex.message); sel.value = sg.status; }
+        });
+        const noteBtn = document.createElement('button'); noteBtn.className = 'chip-btn'; noteBtn.textContent = sg.adminNote ? 'Edit note' : 'Add note';
+        noteBtn.addEventListener('click', async () => {
+          const val = prompt('Short note shown under this suggestion (leave blank to clear):', sg.adminNote || '');
+          if (val === null) return;
+          try { Object.assign(sg, await API.updateSuggestion(sg.id, { adminNote: val })); renderSuggestions(); }
+          catch (ex) { alert(ex.message); }
+        });
+        actions.append(sel, noteBtn);
+      }
+      if (sgIsAdmin() || (sg.mine && sg.status === 'open')) {
+        const del = document.createElement('button'); del.className = 'chip-btn'; del.textContent = 'Delete';
+        del.addEventListener('click', async () => {
+          if (!confirm('Delete this suggestion?')) return;
+          try { await API.deleteSuggestion(sg.id); SUGGESTIONS = SUGGESTIONS.filter(x => x.id !== sg.id); renderFilters(); renderSuggestions(); }
+          catch (ex) { alert(ex.message); }
+        });
+        actions.appendChild(del);
+      }
+      if (actions.children.length) body.appendChild(actions);
+
+      card.append(vote, body);
+      return card;
+    }
+
+    function renderSuggestions() {
+      const list = document.getElementById('sg-list');
+      const sort = document.getElementById('sg-sort').value;
+      let items = SUGGESTIONS.filter(x => SG_FILTER === 'all' || x.status === SG_FILTER);
+      items.sort((a, b) => sort === 'new'
+        ? new Date(b.createdAt) - new Date(a.createdAt)
+        : (b.voteCount - a.voteCount) || (new Date(b.createdAt) - new Date(a.createdAt)));
+      list.textContent = '';
+      if (!items.length) {
+        const empty = document.createElement('p'); empty.className = 'admin-hint';
+        empty.textContent = SUGGESTIONS.length ? 'Nothing here yet.' : 'No suggestions yet \u2014 be the first!';
+        list.appendChild(empty);
+        return;
+      }
+      items.forEach(sg => list.appendChild(sgCard(sg)));
+    }
+
+    async function loadSuggestions() {
+      try { SUGGESTIONS = await API.listSuggestions(); }
+      catch { document.getElementById('sg-list').textContent = 'Couldn\u2019t load suggestions.'; return; }
+      renderFilters();
+      renderSuggestions();
+    }
+
+    async function submitSuggestion() {
+      setSgError('');
+      const title = document.getElementById('sg-title').value.trim();
+      const body = document.getElementById('sg-body').value.trim();
+      if (!title) return setSgError('Give your suggestion a title.');
+      const btn = document.getElementById('sg-submit');
+      btn.disabled = true;
+      try {
+        const created = await API.addSuggestion(title, body);
+        SUGGESTIONS.push(created);
+        document.getElementById('sg-title').value = '';
+        document.getElementById('sg-body').value = '';
+        document.getElementById('sg-counter').textContent = '0 / 1000';
+        SG_FILTER = 'all';
+        document.getElementById('sg-sort').value = 'new';
+        renderFilters();
+        renderSuggestions();
+      } catch (ex) { setSgError(ex.message); }
+      finally { btn.disabled = false; }
+    }
+
+    document.getElementById('sg-body').addEventListener('input', e => {
+      document.getElementById('sg-counter').textContent = e.target.value.length + ' / 1000';
+    });
+
+    // Re-render when sign-in state is known/changes (votes + admin controls depend on it).
+    document.addEventListener('seal:user-ready', async () => {
+      showForm();
+      await loadSuggestions();
+    });
+
+    initSealPage();
+  </script>
+</body>
+</html>
