+//   redirected to that host, so none of that bandwidth is served by this server.
+//   Existing game URLs stored in the database keep working unchanged.
+// Unset (local dev) — the server serves ../static itself, exactly like before.
+// STATIC_DIR overrides where that folder is.
+function resolveStaticBaseUrl(raw) {
+  const v = String(raw || '').trim().replace(/\/+$/, '');
+  if (!v) return '';
+  try {
+    const u = new URL(v);
+    if (/^https?:$/.test(u.protocol)) return u.origin + u.pathname.replace(/\/+$/, '');
+  } catch {}
+  console.error(`[seal] STATIC_BASE_URL "${raw}" is not a valid http(s) URL — ignoring it and serving static files locally.`);
+  return '';
+}
