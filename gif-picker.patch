+    // ── GIF links → pictures ───────────────────────────────────────
+    // Links on well-known GIF hosts show right away. A .gif link from any
+    // other site gets a "Load GIF" button instead: loading it from a random
+    // server tells that server your IP address, so it takes a click.
+    const TRUSTED_GIF_HOSTS = [
+      /^(?:media\d*|i)\.giphy\.com$/, /^(?:media\d*|c)\.tenor\.com$/, /^i\.imgur\.com$/,
+      /^(?:cdn\.discordapp\.com|media\.discordapp\.net)$/
+    ];
+    function gifFromUrl(raw) {
+      let u;
+      try { u = new URL(raw); } catch { return null; }
+      if (u.protocol !== 'https:' && u.protocol !== 'http:') return null;
+      const host = u.hostname.toLowerCase();
+      // A pasted Giphy *page* link (giphy.com/gifs/funny-cat-AbC123) -> its picture
+      if (host === 'giphy.com' || host === 'www.giphy.com') {
+        const m = u.pathname.match(/^\/gifs\/(?:[^/]*-)?([A-Za-z0-9]+)\/?$/);
+        return m ? { src: `https://media.giphy.com/media/${m[1]}/giphy.gif`, trusted: true, host: 'giphy.com' } : null;
+      }
+      if (!/\.gif$/i.test(u.pathname)) return null;
+      const trusted = TRUSTED_GIF_HOSTS.some(re => re.test(host));
+      if (u.protocol === 'http:') { if (!trusted) return null; u.protocol = 'https:'; } // http images would be blocked on an https site
+      return { src: u.href, trusted, host };
+    }
+    function findGifLinks(text) {
+      const found = [], seen = new Set();
+      (String(text || '').match(/https?:\/\/[^\s<>"']+/g) || []).forEach(raw => {
+        const g = gifFromUrl(raw.replace(/[.,!?)\]]+$/, ''));
+        if (g && !seen.has(g.src) && found.length < 3) { seen.add(g.src); found.push(g); }
+      });
+      return found;
+    }
+    function buildGifImage(src, who, onFail) {
+      const stick = isNearBottom();
+      const link = document.createElement('a');
+      link.href = src;
+      link.target = '_blank';
+      link.rel = 'noopener noreferrer';
+      const img = document.createElement('img');
+      img.className = 'chat-image chat-gif';
+      img.loading = 'lazy';
+      img.decoding = 'async';
+      img.referrerPolicy = 'no-referrer';
+      img.alt = 'GIF from ' + who;
+      img.addEventListener('load', () => { if (stick) scrollToBottom(); });
+      img.addEventListener('error', () => { link.remove(); if (onFail) onFail(); });
+      img.src = src;
+      link.appendChild(img);
+      return link;
+    }
+    function renderGifLinks(body, text, msg) {
+      const gifs = findGifLinks(text);
+      if (!gifs.length) return;
+      const textEl = body.querySelector('.chat-text');
+      // A message that is *just* a GIF link shows only the GIF, like Discord.
+      const onlyLink = !!textEl && /^https?:\/\/\S+$/.test(String(text).trim());
+      if (onlyLink && gifs.length === 1) textEl.classList.add('hidden');
+      const restore = () => textEl && textEl.classList.remove('hidden');
+      gifs.forEach(g => {
+        if (g.trusted) { body.appendChild(buildGifImage(g.src, msg.username, restore)); return; }
